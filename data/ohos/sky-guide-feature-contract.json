{
  "schemaVersion": 1,
  "status": "research-only",
  "researchDate": "2026-08-30",
  "benchmark": {
    "product": "Sky Guide",
    "company": "Fifth Star Labs LLC",
    "officialSources": [
      "https://www.fifthstarlabs.com/",
      "https://www.fifthstarlabs.com/team",
      "https://www.fifthstarlabs.com/news",
