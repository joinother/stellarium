{
  "schema": 1,
  "policy": {
    "runtime": "local-only",
    "buildDefaultSource": "upstream",
    "allowedBuildSources": ["local", "mirror", "upstream"],
    "mirrorMustBeExplicit": true,
    "networkPermissionRequiredAtRuntime": false
  },
  "sources": [
    {
      "id": "satellites.tle.stations",
      "kind": "catalog",
      "format": "tle-3le",
      "upstreamUrl": "https://celestrak.org/NORAD/elements/gp.php?GROUP=stations&FORMAT=3LE",
      "mirrorPath": "/v1/catalogs/satellites/stations.3le",
      "localPath": "data/ohos/mirror-cache/satellites/stations.3le",
      "output": "plugins/Satellites/resources/satellites.json",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "satellites.tle.visual",
      "kind": "catalog",
      "format": "tle-3le",
      "upstreamUrl": "https://celestrak.org/NORAD/elements/gp.php?GROUP=visual&FORMAT=3LE",
      "mirrorPath": "/v1/catalogs/satellites/visual.3le",
      "localPath": "data/ohos/mirror-cache/satellites/visual.3le",
      "output": "plugins/Satellites/resources/satellites.json",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "satellites.tle.active",
      "kind": "catalog",
      "format": "tle-3le",
      "upstreamUrl": "https://celestrak.org/NORAD/elements/gp.php?GROUP=active&FORMAT=3LE",
