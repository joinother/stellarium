      "output": "plugins/Satellites/resources/satellites.json",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "satellites.tle.satnogs",
      "kind": "catalog-supplement",
      "format": "satnogs-json",
      "upstreamUrl": "https://db.satnogs.org/api/tle/?format=json",
      "mirrorPath": "/v1/catalogs/satellites/satnogs.json",
      "localPath": "data/ohos/mirror-cache/satellites/satnogs.json",
      "output": "plugins/Satellites/resources/satellites.json",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "catalog.exoplanets",
      "kind": "catalog",
      "format": "json",
      "upstreamUrl": "https://www.stellarium.org/json/exoplanets.json",
