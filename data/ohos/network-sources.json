      "localPath": "data/ohos/mirror-cache/catalogs/supernovae.json",
      "output": "plugins/Supernovae",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "catalog.pulsars",
      "kind": "catalog",
      "format": "json",
      "upstreamUrl": "https://stellarium.org/json/pulsars.json",
      "mirrorPath": "/v1/catalogs/pulsars.json",
      "localPath": "data/ohos/mirror-cache/catalogs/pulsars.json",
      "output": "plugins/Pulsars",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "catalog.quasars",
      "kind": "catalog",
      "format": "json",
      "upstreamUrl": "https://stellarium.org/json/quasars.json",
      "mirrorPath": "/v1/catalogs/quasars.json",
      "localPath": "data/ohos/mirror-cache/catalogs/quasars.json",
      "output": "plugins/Quasars",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "survey.hips.directory",
      "kind": "survey-directory",
      "format": "ivoa-hips-json",
      "upstreamUrl": "https://data.stellarium.org/surveys/hipslist",
      "mirrorPath": "/v1/surveys/hips/index.json",
      "localPath": "data/ohos/mirror-cache/surveys/hips/index.json",
      "output": "data/hips",
      "outboundFields": ["sky-tile-identifier"],
      "runtimeDefault": "disabled"
    },
    {
      "id": "survey.dss.tiles",
      "kind": "survey-tiles",
      "format": "jpg-tiles",
      "upstreamUrl": "http://dss.stellarium.org/survey/{level}/{x}_{y}.jpg",
      "mirrorPath": "/v1/surveys/dss/{level}/{x}_{y}.jpg",
      "localPath": "data/ohos/mirror-cache/surveys/dss",
      "output": "data/surveys/dss",
      "outboundFields": ["sky-tile-identifier"],
      "runtimeDefault": "disabled"
    },
    {
      "id": "query.simbad",
      "kind": "online-query",
      "format": "simbad-response",
      "upstreamUrl": "https://simbad.u-strasbg.fr/",
      "mirrorPath": "/v1/query/simbad",
      "localPath": "data/ohos/mirror-cache/query/simbad",
      "output": "runtime-only",
      "outboundFields": ["user-query"],
      "runtimeDefault": "disabled"
    },
    {
      "id": "catalog.mpc",
      "kind": "catalog-query",
      "format": "mpc-orbit-elements",
      "upstreamUrl": "https://www.minorplanetcenter.net/",
      "mirrorPath": "/v1/catalogs/mpc",
      "localPath": "data/ohos/mirror-cache/catalogs/mpc",
      "output": "plugins/SolarSystemEditor",
      "outboundFields": ["object-query"],
      "runtimeDefault": "disabled"
    },
    {
      "id": "realtime.planes",
      "kind": "realtime-query",
      "format": "aircraft-json",
      "upstreamUrl": "https://opendata.adsb.fi/api/v2/lat/{lat}/lon/{lon}/dist/{radius}",
      "mirrorPath": "/v1/realtime/planes/{lat}/{lon}/{radius}",
      "localPath": "data/ohos/mirror-cache/realtime/planes",
      "output": "plugins/Planes",
      "outboundFields": ["latitude", "longitude", "radius"],
      "runtimeDefault": "disabled"
    }
