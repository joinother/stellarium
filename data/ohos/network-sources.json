      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "catalog.novae",
      "kind": "catalog",
      "format": "json",
      "upstreamUrl": "https://stellarium.org/json/novae.json",
      "mirrorPath": "/v1/catalogs/novae.json",
      "localPath": "data/ohos/mirror-cache/catalogs/novae.json",
      "output": "plugins/Novae",
      "outboundFields": [],
      "runtimeDefault": "bundled"
    },
    {
      "id": "catalog.supernovae",
      "kind": "catalog",
      "format": "json",
      "upstreamUrl": "https://stellarium.org/json/supernovae.json",
