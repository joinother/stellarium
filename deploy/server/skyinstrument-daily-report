#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""星象仪每日安全汇总（固定 08:00 发送，无论有无异常）。

内容：服务器自检、内容巡检、哈希比对、定时器状态、最近处置记录。
无异常时也发一封"全部正常"，作为持续性证明与留档。
"""
import glob
import os
import re
import subprocess
import sys
from datetime import datetime

os.environ['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

RECORDS = '/srv/skyinstrument/security-records'
AI_STATE = '/var/lib/skyinstrument/ai-status.json'
AI_USAGE = '/var/lib/skyinstrument/ai-usage.json'
PERF_STATE = '/var/lib/skyinstrument/audit-perf.json'
MIRROR_MANIFEST = '/srv/tle-mirror/v1/manifest.json'
IMAGE_HASHES = '/var/lib/skyinstrument/image-hashes.json'
TRAFFIC = '/var/lib/skyinstrument/traffic-stats.json'
MIRROR_STALE_HOURS = 24      # 星历每 3 小时更新，超过 24 小时视为停更
MIRROR_CRITICAL_HOURS = 72   # 超过 72 小时视为重大异常
MAIL_CONF = '/etc/skyinstrument/mail.conf'
NOTIFY = '/usr/local/sbin/skyinstrument-notify'
INCIDENT_LOG = os.path.join(RECORDS, 'incident-log.tsv')
INCIDENT_CONF = '/etc/skyinstrument-website/conf.d/incident.conf'


def read_latest(pattern):
    files = sorted(glob.glob(os.path.join(RECORDS, pattern)))
    if not files:
        return None, ''
    try:
        return files[-1], open(files[-1], encoding='utf-8', errors='replace').read()
    except Exception:  # noqa: BLE001
        return files[-1], ''


def summarize_health(text):
    m = re.search(r'检查项：(\d+)，异常：(\d+)', text)
    items = re.findall(r'\| ([^|]+?) \| (通过|\*\*异常\*\*) \|', text)
    fails = [i[0].strip() for i in items if '异常' in i[1]]
    return (m.group(1), m.group(2), fails) if m else ('?', '?', [])


def summarize_audit(text):
    m = re.search(r'文件总数：(\d+)，问题数：(\d+)', text)
    items = re.findall(r'\| (高|中) \| ([^|]+?) \| ([^|]+?) \|', text)
    return (m.group(1), m.group(2), items) if m else ('?', '?', [])


def summarize_hash(text):
    m = re.search(r'差异行数：(\d+)', text)
    return m.group(1) if m else '?'


def _usage_data():
    import json as _j
    try:
        return _j.load(open(AI_USAGE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return {}


def _cost(pt, ct):
    return pt / 1e6 * 2 + ct / 1e6 * 8


def ai_usage_line():
    import time as _t
    data = _usage_data()
    day = data.get(_t.strftime('%Y-%m-%d')) or {}
    if not day.get('calls'):
        return '今日未调用'
    return '调用 %d 次，token %d/%d，估算 %.3f 元' % (
        day.get('calls', 0), day.get('prompt_tokens', 0),
        day.get('completion_tokens', 0),
        _cost(day.get('prompt_tokens', 0), day.get('completion_tokens', 0)))


def ai_month_line():
    """本月累计调用与费用。"""
    import time as _t
    data = _usage_data()
    prefix = _t.strftime('%Y-%m')
    calls = pt = ct = 0
    for k, v in data.items():
        if k == 'lifetime' or not isinstance(v, dict) or not k.startswith(prefix):
            continue
        calls += v.get('calls', 0)
        pt += v.get('prompt_tokens', 0)
        ct += v.get('completion_tokens', 0)
    if not calls:
        return '本月未调用'
    return '%d 次，估算 %.3f 元' % (calls, _cost(pt, ct))


def ai_anomaly():
    """今日调用量是否超过本月日均 3 倍；返回提示文字或 None。"""
    import time as _t
    data = _usage_data()
    today = _t.strftime('%Y-%m-%d')
    prefix = _t.strftime('%Y-%m')
    cur = (data.get(today) or {}).get('calls', 0)
    prev = [v.get('calls', 0) for k, v in data.items()
            if k != 'lifetime' and isinstance(v, dict) and k.startswith(prefix) and k != today]
    if len(prev) < 2 or not cur:
        return None
    avg = sum(prev) / len(prev)
    if avg <= 0:
        return None
    if cur >= max(avg * 3, 12):
        return '今日调用 %d 次，为本月日均 %.1f 次的 %.1f 倍，请确认是否异常' % (
            cur, avg, cur / avg)
    return None


def traffic_line():
    try:
        import json as _j
        d = _j.load(open(TRAFFIC, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return '无数据', []
    t = d.get('today') or {}
    up = d.get('upstream') or {}
    notes = []
    if t.get('error_5xx'):
        notes.append('今日出现 %d 次 5xx，需检查服务' % t['error_5xx'])
    txt = 'PV %d，独立 IP %d，扫描 %d 次' % (t.get('total', 0), t.get('ips', 0), t.get('scan_hits', 0))
    refs = t.get('refs') or {}
    if refs:
        txt += '；来源 ' + '、'.join('%s %d' % (k, v) for k, v in list(refs.items())[:3])
    uas = t.get('uas') or {}
    if uas:
        txt += '；设备 ' + '、'.join('%s %d' % (k, v) for k, v in list(uas.items())[:3])
    if up:
        txt += '；和风 今日 %d 次 / 本月 %d 次' % (up.get('day', 0), up.get('month', 0))
    return txt, notes


def image_line():
    try:
        import json as _j
        n = len(_j.load(open(IMAGE_HASHES, encoding='utf-8')))
        return '已建指纹 %d 张' % n
    except Exception:  # noqa: BLE001
        return '无基线'


def mirror_status():
    """镜像数据新鲜度：manifest 的生成时间 + 各源 ok 状态。"""
    import json as _j
    from datetime import datetime as _dt
    try:
        d = _j.load(open(MIRROR_MANIFEST, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return '清单不可读', ['镜像 manifest.json 无法解析，需检查 tle-mirror 任务'], False
    gen = d.get('generatedAt', '')
    try:
        ts = _dt.strptime(gen.replace('Z', ''), '%Y-%m-%dT%H:%M:%S.%f')
    except Exception:  # noqa: BLE001
        return '时间格式异常', ['镜像 manifest 的 generatedAt 无法解析'], True
    hours = (_dt.utcnow() - ts).total_seconds() / 3600.0
    srcs = d.get('sources', [])
    bad = [x.get('id') for x in srcs if not x.get('ok', True)]
    notes = []
    critical = False
    if bad:
        notes.append('拉取失败的源：%s' % '、'.join(bad[:5]))
    if hours >= MIRROR_CRITICAL_HOURS:
        notes.append('镜像已 %.0f 小时未更新，可能导致卫星数据过期' % hours)
        critical = True
    elif hours >= MIRROR_STALE_HOURS:
        notes.append('镜像已 %.0f 小时未更新（正常应每 3 小时一次）' % hours)
    label = '%.1f 小时前更新' % hours
    if hours >= MIRROR_STALE_HOURS:
        label += '（停更）'
    return label, notes, critical


def audit_perf_line():
    try:
        import json as _j
        d = _j.load(open(PERF_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return '无数据', []
    sec = d.get('seconds', 0)
    if sec >= 60:
        return '%.1f 秒（偏慢，需检查）' % sec, ['巡检耗时超过 60 秒，可能影响服务器负载']
    return '%.1f 秒' % sec, []


def active_blocks():
    """当前生效的拦截规则（nginx conf.d 里的 503）。"""
    if not os.path.exists(INCIDENT_CONF):
        return []
    out = []
    for line in open(INCIDENT_CONF, encoding='utf-8'):
        line = line.strip()
        if not line.startswith('location ='):
            continue
        m = re.search(r'location = (\S+)', line)
        t = re.search(r'incident (\d{8}-\d{6})', line)
        if m:
            out.append((m.group(1), t.group(1) if t else '?'))
    return out


def ai_status():
    try:
        import json as _json
        st = _json.load(open(AI_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return '未知', []
    fails = int(st.get('consecutive_fail', 0) or 0)
    notes = []
    if st.get('last_reason'):
        notes.append('最近失败原因：%s' % st['last_reason'][:80])
    if st.get('refused_today'):
        notes.append('今日模型拒绝输出 %s 次（内容过滤）' % st['refused_today'])
    if fails >= 3:
        return '降级（连续失败 %s 次，仅规则层生效）' % fails, notes
    if fails:
        return '告警（连续失败 %s 次）' % fails, notes
    return '正常', notes


def timers():
    try:
        out = subprocess.run(['systemctl', 'list-timers', 'skyinstrument-*', '--no-pager'],
                             stdout=subprocess.PIPE, universal_newlines=True, timeout=15).stdout
        return [l for l in out.splitlines() if 'skyinstrument' in l]
    except Exception:  # noqa: BLE001
        return []


def main():
    hf, htext = read_latest('healthcheck-*.txt')
    af, atext = read_latest('content-audit-*.txt')
    df, dtext = read_latest('hash-diff-*.txt')

    h_total, h_fail, h_fails = summarize_health(htext)
    a_total, a_issues, a_items = summarize_audit(atext)
    h_diff = summarize_hash(dtext)

    all_ok = (h_fail in ('0', '?')) and (a_issues in ('0', '?')) and (h_diff in ('0', '?')) \
             and ai_state in ('正常', '未知')

    ai_state, ai_notes = ai_status()
    blocks = active_blocks()
    mirror, mirror_notes, _mirror_critical = mirror_status()
    perf, perf_notes = audit_perf_line()
    _anom = ai_anomaly()
    rows = [
        ('镜像数据', mirror, mirror_notes),
        ('图片审查', image_line(), []),
        ('访问与接口',) + traffic_line(),
        ('巡检耗时', perf, perf_notes),
        ('AI 用量', ai_usage_line(), [_anom] if _anom else []),
        ('AI 本月累计', ai_month_line(), []),
        ('当前生效拦截', '%d 条' % len(blocks),
         ['%s（自 %s）' % (p, t) for p, t in blocks[:5]]),
        ('AI 判定层', ai_state, ai_notes),
        ('服务器自检', '%s 项，异常 %s' % (h_total, h_fail), h_fails),
        ('内容巡检', '%s 个文件，问题 %s' % (a_total, a_issues),
         ['%s：%s（%s）' % (i[0], i[1].strip(), i[2].strip()) for i in a_items[:6]]),
        ('文件哈希比对', '差异 %s 行' % h_diff, []),
    ]

    body_txt = ['星象仪每日安全汇总', '时间：' + datetime.now().strftime('%Y-%m-%d %H:%M:%S'), '']
    body_html = ['<div style="font-family:-apple-system,PingFang SC,Microsoft YaHei,sans-serif;'
                 'max-width:720px;margin:0 auto;font-size:14px;color:#1f2328">',
                 '<h2 style="margin:0 0 4px">星象仪 · 每日安全汇总</h2>',
                 '<p style="margin:0 0 14px;color:#57606a;font-size:13px">%s</p>'
                 % datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
                 '<p style="margin:0 0 16px;padding:10px 14px;border-radius:6px;'
                 'background:%s;color:#fff;font-weight:600;display:inline-block">%s</p>'
                 % (('#0a7d32', '全部正常') if all_ok else ('#b3261e', '存在需关注的问题')),
                 '<table style="border-collapse:collapse;width:100%;font-size:13px">',
                 '<thead><tr style="background:#f6f8fa">'
                 '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">项目</th>'
                 '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">结果</th>'
                 '</tr></thead><tbody>']
    for name, result, details in rows:
        body_txt.append('%s：%s' % (name, result))
        extra = ''
        if details:
            extra = '<div style="color:#b3261e;font-size:12px;margin-top:4px">' + '<br>'.join(details) + '</div>'
            body_txt.extend('  - ' + d for d in details)
        body_html.append('<tr><td style="padding:8px 10px;border:1px solid #d0d7de">%s</td>'
                         '<td style="padding:8px 10px;border:1px solid #d0d7de">%s%s</td></tr>'
                         % (name, result, extra))
    body_html.append('</tbody></table>')

    if blocks:
        body_txt.append('')
        body_txt.append('当前生效拦截（这些路径返回 503）：')
        body_txt.extend('  %s（自 %s）' % (p, t) for p, t in blocks)
        body_txt.append('  解除：skyinstrument-incident --rollback <时间戳>')

    trows = timers()
    body_txt.append('')
    body_txt.append('定时任务：')
    body_txt.extend('  ' + t.strip() for t in trows)
    body_html.append('<h3 style="margin:18px 0 6px;font-size:14px">定时任务</h3>'
                     '<pre style="background:#f6f8fa;padding:10px;border-radius:6px;'
                     'font-size:12px;overflow:auto">%s</pre>' % '\n'.join(trows))

    if os.path.exists(INCIDENT_LOG):
        lines = open(INCIDENT_LOG, encoding='utf-8').read().splitlines()[-5:]
        body_txt.append('')
        body_txt.append('最近处置记录：')
        body_txt.extend('  ' + l.replace('\t', ' | ') for l in lines)
        body_html.append('<h3 style="margin:18px 0 6px;font-size:14px">最近处置记录</h3>'
                         '<pre style="background:#f6f8fa;padding:10px;border-radius:6px;'
                         'font-size:12px;overflow:auto">%s</pre>'
                         % '\n'.join(l.replace('\t', ' | ') for l in lines))

    body_html.append('<p style="margin:16px 0 0;color:#57606a;font-size:12px">'
                     '本邮件每天 08:00 定时发送；紧急问题会单独即时告警。</p></div>')
    text = '\n'.join(body_txt)
    html = ''.join(body_html)

    out = os.path.join(RECORDS, 'daily-report-%s.txt' % datetime.now().strftime('%Y%m%d'))
    with open(out, 'w', encoding='utf-8') as fh:
        fh.write(text + '\n')
    print(text)

    import tempfile
    import subprocess as _sp
    tf = tempfile.NamedTemporaryFile('w', suffix='.txt', delete=False, encoding='utf-8')
    tf.write(text)
    tf.close()
    hf = tempfile.NamedTemporaryFile('w', suffix='.html', delete=False, encoding='utf-8')
    hf.write(html)
    hf.close()
    try:
        r = _sp.run([NOTIFY, '--level', 'daily',
                     '--subject', '[星象仪日报] %s %s' % (
                         datetime.now().strftime('%m-%d'), '全部正常' if all_ok else '有需关注问题'),
                     '--text-file', tf.name, '--html-file', hf.name],
                    stdout=_sp.PIPE, stderr=_sp.STDOUT, universal_newlines=True, timeout=60)
        print((r.stdout or '').strip())
    finally:
        for _p in (tf.name, hf.name):
            if os.path.exists(_p):
                os.unlink(_p)
    return 0


if __name__ == '__main__':
    sys.exit(main())
