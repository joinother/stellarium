[Unit]
Description=Skyinstrument sensitive lexicon auto update
Documentation=file:/srv/skyinstrument/security-records/00-README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /var/lib/skyinstrument/lexicon-update.lock /usr/local/sbin/skyinstrument-lexicon-update
Nice=19
CPUQuota=30%
IOSchedulingClass=idle
