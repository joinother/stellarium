[Unit]
Description=Skyinstrument daily site content audit
Documentation=file:/srv/skyinstrument/security-records/00-README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /var/lib/skyinstrument/content-audit.lock /usr/local/sbin/skyinstrument-content-audit
Nice=19
CPUQuota=40%
IOSchedulingClass=idle
