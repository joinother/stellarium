[Unit]
Description=Skyinstrument daily full-site content review (all pages)
Documentation=file:/srv/skyinstrument/security-records/00-README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /var/lib/skyinstrument/fullscan.lock /usr/local/sbin/skyinstrument-content-audit --sample all
Nice=19
CPUQuota=30%
IOSchedulingClass=idle
