#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""A1：轻量哨兵——每 10 分钟比较站点文件元数据及控制文件哈希。

设计要点：
- 站点比较大小和修改时间，控制文件比较 SHA-256；不直接调用 AI
- 动态状态页输出、巡检报告、备份、日志不触发内容巡检
- 每 10 分钟一轮；同一轮多次变化只触发一次
- 每小时最多触发 6 次完整巡检，避免批量发布打爆 AI 调用
- 03:15–03:30 备份窗口内跳过
- 发布进行中（/var/lib/skyinstrument/publish.lock 存在）时跳过
"""
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime

os.environ['PATH'] = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

NGINX_CONF = '/etc/skyinstrument-website/nginx.conf'
SITE_DIR = '/srv/skyinstrument/website/current'
STATE = '/var/lib/skyinstrument/file-hashes.json'
PACE = '/var/lib/skyinstrument/quickcheck-pace.json'
LOCK = '/var/lib/skyinstrument/publish.lock'
AUDIT_BIN = '/usr/local/sbin/skyinstrument-content-audit'
MAX_RUNS_PER_HOUR = 6
SKIP_WINDOW = (3 * 60 + 15, 3 * 60 + 30)   # 03:15–03:30 备份窗口
MAX_FILES = 20000
CONTROL_FILES = (
    NGINX_CONF,
    '/usr/local/sbin/skyinstrument-status-page',
    '/etc/systemd/system/skyinstrument-status-page.service',
    '/etc/systemd/system/skyinstrument-status-page.timer',
)


def served_dirs():
    dirs = []
    if os.path.exists(NGINX_CONF):
        for line in open(NGINX_CONF, encoding='utf-8', errors='replace'):
            m = re.match(r'\s*(root|alias)\s+([^;]+);', line.strip())
            if m and m.group(2).strip().startswith('/') and os.path.isdir(m.group(2).strip()):
                dirs.append(os.path.normpath(m.group(2).strip()))
    if os.path.isdir(SITE_DIR):
        dirs.append(os.path.normpath(SITE_DIR))
    uniq = sorted(d for d in set(dirs) if d != '/srv/skyinstrument/status')
    return [d for d in uniq if not any(d != k and d.startswith(k + os.sep) for k in uniq)]


def snapshot():
    result = {}
    for filename in CONTROL_FILES:
        try:
            with open(filename, 'rb') as source:
                result[filename] = 'sha256:' + hashlib.sha256(source.read()).hexdigest()
        except OSError:
            result[filename] = 'unavailable'
    n = 0
    for root in served_dirs():
        for dp, _dn, fns in os.walk(root):
            for fn in fns:
                p = os.path.join(dp, fn)
                if os.path.islink(p):
                    continue
                try:
                    st = os.stat(p)
                    result[p] = '%d:%d' % (st.st_size, int(st.st_mtime))
                    n += 1
                except Exception:  # noqa: BLE001
                    continue
                if n >= MAX_FILES:
                    return result
    return result


def changed(prev, cur):
    out = [p for p in cur if prev.get(p) != cur[p]]
    out += [p for p in prev if p not in cur]
    return out


def pace_allow():
    """每小时最多触发 N 次完整巡检。"""
    try:
        data = json.load(open(PACE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        data = {'runs': []}
    now = time.time()
    runs = [t for t in data.get('runs', []) if now - t < 3600]
    if len(runs) >= MAX_RUNS_PER_HOUR:
        return False, len(runs)
    runs.append(now)
    data['runs'] = runs
    os.makedirs(os.path.dirname(PACE), exist_ok=True)
    with open(PACE, 'w', encoding='utf-8') as fh:
        json.dump(data, fh)
    return True, len(runs)


def main():
    now = datetime.now()
    if os.path.exists(LOCK):
        print('发布进行中，跳过')
        return 0
    minutes = now.hour * 60 + now.minute
    if SKIP_WINDOW[0] <= minutes <= SKIP_WINDOW[1]:
        print('备份窗口内，跳过')
        return 0

    cur = snapshot()
    try:
        prev = json.load(open(STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        prev = {}

    diffs = changed(prev, cur)
    if not diffs:
        print('%s 无变化（%d 个文件）' % (now.strftime('%H:%M:%S'), len(cur)))
        with open(STATE, 'w', encoding='utf-8') as fh:
            json.dump(cur, fh)
        return 0

    site_diffs = [d for d in diffs if '/website/' in d]
    mirror_diffs = [d for d in diffs if '/tle-mirror/' in d]
    ctrl_diffs = [d for d in diffs if d not in site_diffs and d not in mirror_diffs]
    print('%s 检测到 %d 个文件变化（页面 %d，镜像 %d，控制文件 %d）示例：%s'
          % (now.strftime('%H:%M:%S'), len(diffs), len(site_diffs), len(mirror_diffs),
             len(ctrl_diffs), ', '.join(diffs[:3])))

    # 只有镜像或控制文件变化时不跑完整内容巡检：
    # 镜像由每日全审的结构校验与新鲜度检查覆盖，控制文件由哈希记录留痕。
    if not site_diffs:
        print('  无页面变更，仅记录基线（镜像与控制文件交由每日巡检覆盖）')
        with open(STATE, 'w', encoding='utf-8') as fh:
            json.dump(cur, fh)
        return 0

    ok, count = pace_allow()
    if not ok:
        # 关键：限流时不更新哈希基线，否则这次变更会被"吃掉"，
        # 下一轮看不到差异，篡改就永远不会被审计。
        print('本小时已触发 %d 次巡检，达到上限；保留基线不动，下一轮继续触发' % count)
        return 0
    else:
        env = dict(os.environ)
        env['AUDIT_AI_TIME_BUDGET'] = '60'   # 哨兵只给模型 60 秒，避免拖成几分钟
        try:
            r = subprocess.run([AUDIT_BIN], stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                               universal_newlines=True, timeout=600, env=env)
            for line in (r.stdout or '').splitlines():
                if any(k in line for k in ('问题数', '留给每日汇总', '告警邮件', '已由应急处置',
                                           '24 小时内告警过', 'AI 当日预算', '时间预算')):
                    print('  ' + line.strip())
        except subprocess.TimeoutExpired:
            print('  巡检超时（600 秒），先记录基线，未看完的页面交由每日全站全审补查')
        except Exception as exc:  # noqa: BLE001
            print('  巡检异常：%s: %s' % (type(exc).__name__, exc))

    with open(STATE, 'w', encoding='utf-8') as fh:
        json.dump(cur, fh)
    return 0


if __name__ == '__main__':
    sys.exit(main())
