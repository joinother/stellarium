}

# 违禁词（分类）
BLOCK_WORDS = {
    '涉政': ['颠覆国家', '推翻政府', '分裂国家', '煽动颠覆'],
    '涉黄': ['色情', '裸聊', '约炮', '成人视频', '情色'],
    '涉赌': ['赌博', '博彩', '百家乐', '六合彩', '时时彩', '赌球'],
    '涉诈': ['刷单', '杀猪盘', '兼职日结', '代开发票', '办证', '代办信用卡', '高额贷款', '洗钱'],
    '涉毒': ['毒品', '冰毒', '大麻交易', '摇头丸'],
    '涉枪': ['枪支', '弹药', '仿真枪'],
}

# 广告法极限词（用短语降低误报）
AD_WORDS = ['最好的', '最佳', '最高级', '国家级', '世界级', '第一品牌', '行业第一', '全国第一',
            '永久免费', '终身免费', '100%', '绝对准确', '绝对精准', '独家代理', '唯一指定',
            '领先全球', '顶级品质', '史无前例', '万能']

# 文本类扩展名（按内容扫描）
TEXT_EXT = {'.html', '.htm', '.txt', '.json', '.csv', '.xml', '.js', '.css', '.md', '.3le', '.tle'}
# 图片类扩展名（校验魔数与内嵌脚本）
IMAGE_EXT = {'.png', '.jpg', '.jpeg', '.webp', '.gif', '.svg', '.ico'}
# 构建产物与字体：不做文本规则扫描（JS/CSS 里必然含 javascript:、100% 等字样），
# 其完整性由每日备份哈希清单覆盖；仅做魔数/夹带检查
CODE_EXT = {'.js', '.mjs', '.css', '.map'}
OTHER_OK_EXT = {'.woff', '.woff2', '.ttf'}
# 单文件扫描上限：超出只算哈希不读内容，避免大文件拖慢巡检
MAX_SCAN_BYTES = 4 * 1024 * 1024
MAX_FILES = 20000

PHONE_RE = re.compile(r'(?<!\d)1[3-9]\d{9}(?!\d)')
EMAIL_RE = re.compile(r'[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}')
EMAIL_ALLOW = {'1134873571@qq.com'}
HIDDEN_RE = re.compile(
    r'<(div|span|p|a|li|section)[^>]*(display\s*:\s*none|visibility\s*:\s*hidden|'
    r'font-size\s*:\s*0(?:px|rpx|vw)?[;"\s]|text-indent\s*:\s*-\d{3,}|'
    r'opacity\s*:\s*0(?:\.0+)?[;"\s])', re.I)
SUSPICIOUS_RE = re.compile(r'<iframe|<object|<embed|\bonerror\s*=|javascript:\s*\w', re.I)
LINK_RE = re.compile(r'href="(https?://[^"]+)"', re.I)

issues = []        # (级别, 类别, 位置, 说明)
hidden_by_page = {}  # 页面 -> 隐藏元素文字列表
hard_risk_pages = set()  # 隐藏元素内含违禁词的页面（规则优先级最高）
stats = []


def add(level, kind, where, detail):
    issues.append((level, kind, where, detail))


def discover_served_dirs():
    """从 nginx 配置里解析 root / alias，自动覆盖现在与将来新增的被服务目录。"""
    dirs = []
    if os.path.exists(NGINX_CONF):
        for line in open(NGINX_CONF, encoding='utf-8', errors='replace'):
            line = line.strip()
            m = re.match(r'(root|alias)\s+([^;]+);', line)
            if not m:
                continue
            path = m.group(2).strip()
            if not path.startswith('/'):
                continue
            # alias 指向 /x/y/ 时取其目录本身；root 同
            if os.path.isdir(path):
                dirs.append(os.path.normpath(path))
    if os.path.isdir(SITE_DIR):
        dirs.append(os.path.normpath(SITE_DIR))
    # 去重，且去掉被其他目录包含的子目录（子目录会被递归覆盖）
    uniq = sorted(set(dirs))
    kept = []
    for d in uniq:
        if not any(d != k and d.startswith(k + os.sep) for k in uniq):
            kept.append(d)
    return kept


def classify(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in CODE_EXT:
        return 'code'
    if ext in TEXT_EXT:
        return 'text'
    if ext in IMAGE_EXT:
        return 'image'
    if ext in OTHER_OK_EXT:
        return 'asset'
    return 'unexpected'


def check_binary(path, rel):
    """图片与资产：校验魔数，检查是否夹带脚本或可执行内容。"""
    ext = os.path.splitext(path)[1].lower()
    try:
        with open(path, 'rb') as fh:
            head = fh.read(4096)
    except Exception as exc:  # noqa: BLE001
        add('中', '文件不可读', rel, str(exc)[:80])
        return
    magic = {
        '.png': b'\x89PNG', '.jpg': b'\xff\xd8\xff', '.jpeg': b'\xff\xd8\xff',
        '.gif': b'GIF8', '.webp': b'RIFF', '.ico': b'\x00\x00\x01\x00',
        '.woff': b'wOFF', '.woff2': b'wOF2', '.ttf': b'\x00\x01\x00\x00',
    }.get(ext)
    if magic and not head.startswith(magic):
        add('中', '文件魔数不符', rel, '扩展名 %s 但内容不是该格式' % ext)
    low = head.lower()
    for sig in (b'<script', b'<?php', b'#!/'):
        if sig in low:
            add('高', '资产夹带脚本', rel, '在 %s 文件中发现 %s' % (ext, sig.decode()))


def scan_text_data(text, rel):
    """对数据文件（JSON/CSV/3LE 等）执行与网页相同的规则检查。"""
    for cat, words in BLOCK_WORDS.items():
        for w in words:
            if w in text:
                idx = text.find(w)
                add('高', '违禁词/%s' % cat, rel,
                    '命中「%s」：…%s…' % (w, text[max(0, idx - 30):idx + 30]))
    for w in AD_WORDS:
        if w in text:
            idx = text.find(w)
            add('中', '广告法极限词', rel,
                '命中「%s」：…%s…' % (w, text[max(0, idx - 30):idx + 30]))
    for m in LINK_RE.finditer(text):
        host = re.sub(r'^https?://', '', m.group(1)).split('/')[0].split(':')[0].lower()
        if not any(host == d or host.endswith('.' + d) for d in ALLOWED_DOMAINS):
            add('中', '未登记外链', rel, m.group(1)[:120])
    # 数据文件里出现脚本标签属于异常
    for m in re.finditer(r'<script|<iframe|javascript:', text, re.I):
        add('高', '数据夹带脚本', rel, text[max(0, m.start() - 20):m.start() + 40])


def scan_large_text(path, rel):
    """超过阈值的文本文件：分块流式扫描，避免整文件读入内存。"""
    chunk = 1024 * 1024
    overlap = 256
    hit = 0
    prev = b''
    try:
        with open(path, 'rb') as fh:
            while True:
                buf = fh.read(chunk)
                if not buf:
                    break
                data = (prev + buf).decode('utf-8', 'replace')
                prev = buf[-overlap:]
                for cat, words in BLOCK_WORDS.items():
                    for w in words:
                        if w in data:
                            add('高', '违禁词/%s' % cat, rel, '大文件分块命中「%s」' % w)
                            hit += 1
                if hit > 20:
                    return
    except Exception as exc:  # noqa: BLE001
        add('中', '文件不可读', rel, str(exc)[:80])


def api_endpoints():
    if os.path.exists(API_CONF):
        out = []
        for line in open(API_CONF, encoding='utf-8'):
            line = line.strip()
            if line and not line.startswith('#'):
                out.append(line)
        if out:
            return out
    return API_DEFAULT


def check_api_endpoints():
    """接口级巡检：动态内容不在磁盘上，只能抓响应来查。"""
    for path in api_endpoints():
        url = API_BASE + path
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'content-audit/1.0'})
            with urllib.request.urlopen(req, timeout=10) as resp:
                status = resp.status
                body = resp.read(API_MAX_BYTES)
        except urllib.error.HTTPError as exc:
            add('中', '接口异常', path, 'HTTP %s' % exc.code)
            continue
        except Exception as exc:  # noqa: BLE001
            add('中', '接口不可达', path, '%s' % str(exc)[:80])
            continue
        if status != 200:
            add('中', '接口状态异常', path, 'HTTP %s' % status)
        if len(body) >= API_MAX_BYTES:
            add('中', '接口响应过大', path, '超过 %d MB' % (API_MAX_BYTES // 1024 // 1024))
        text = body.decode('utf-8', 'replace')
        try:
            json.loads(text)
        except Exception:  # noqa: BLE001
            add('中', '接口响应非 JSON', path, text[:80])
        scan_text_data(text, path)


def visible_text(raw):
    s = re.sub(r'<script.*?</script>', ' ', raw, flags=re.S | re.I)
    s = re.sub(r'<style.*?</style>', ' ', s, flags=re.S | re.I)
    s = re.sub(r'<[^>]+>', ' ', s)
    s = htmllib.unescape(s)
    return re.sub(r'\s+', ' ', s).strip()


def scan_html_rules(raw, name):
    text = visible_text(raw)

    # 1 隐藏内容（同时抽取隐藏区域的文字，供 AI 与硬风险判定使用）
    w = None
    hidden_texts = []
    for m in HIDDEN_RE.finditer(raw):
        tail = raw[m.start():m.start() + 600]
        inner = re.sub(r'<[^>]+>', ' ', tail)
        inner = htmllib.unescape(re.sub(r'\s+', ' ', inner)).strip()
        if inner:
            hidden_texts.append(inner[:200])
        add('高', '隐藏内容', name, '发现隐藏元素：%s' % m.group(0)[:120])
    if hidden_texts:
        hidden_by_page[name] = hidden_texts

    # 2 违禁词
    for cat, words in BLOCK_WORDS.items():
        for w in words:
            if w in text:
                idx = text.find(w)
                add('高', '违禁词/%s' % cat, name, '命中「%s」：…%s…' % (w, text[max(0, idx-30):idx+30]))
                if any(w in ht for ht in hidden_texts):
                    hard_risk_pages.add(name)

    # 3 广告法极限词
    for w in AD_WORDS:
        if w in text:
            idx = text.find(w)
            add('中', '广告法极限词', name, '命中「%s」：…%s…' % (w, text[max(0, idx-30):idx+30]))

    # 4 外链白名单
    for m in LINK_RE.finditer(raw):
        url = m.group(1)
        host = re.sub(r'^https?://', '', url).split('/')[0].split(':')[0].lower()
        # 允许白名单域名及其子域（如 www.qt.io、docs.github.com）
        ok = any(host == d or host.endswith('.' + d) for d in ALLOWED_DOMAINS)
        if not ok:
            add('中', '未登记外链', name, url[:120])

    # 5 个人信息
    for m in PHONE_RE.finditer(text):
        add('高', '个人信息/手机号', name, m.group(0))
    for m in EMAIL_RE.finditer(text):
        if m.group(0) not in EMAIL_ALLOW:
            add('中', '个人信息/邮箱', name, m.group(0))

    # 6 脚本注入特征
    for m in SUSPICIOUS_RE.finditer(raw):
        add('中', '可疑标签', name, m.group(0)[:80])

    return text


def main():
    served = discover_served_dirs()
    if not served:
        served = [SITE_DIR]
    files = []
    for root_dir in served:
        for dirpath, _dirnames, filenames in os.walk(root_dir):
            for fn in sorted(filenames):
                p = os.path.join(dirpath, fn)
                if os.path.islink(p):
                    continue
                files.append(p)
                if len(files) >= MAX_FILES:
                    break
            if len(files) >= MAX_FILES:
                break
    files = sorted(set(files))

    texts = {}
    type_stat = {}
    hash_list = []
    skipped_big = 0

    for p in files:
        rel = os.path.relpath(p, os.path.dirname(served[0]) if len(served) == 1 else '/srv')
        kind = classify(p)
        type_stat[kind] = type_stat.get(kind, 0) + 1
        try:
            size = os.path.getsize(p)
        except Exception:  # noqa: BLE001
            size = -1
        if size > MAX_SCAN_BYTES:
            if kind == 'text':
                scan_large_text(p, rel)      # 大文本流式扫描，不整体读入
                hash_list.append((rel, size, 'streamed'))
            else:
                skipped_big += 1
                hash_list.append((rel, size, 'skipped-big'))
            continue

        if kind == 'text':
            try:
                raw = open(p, encoding='utf-8', errors='replace').read()
            except Exception as exc:  # noqa: BLE001
                add('中', '文件不可读', rel, str(exc)[:80])
                continue
            text = visible_text(raw) if rel.endswith(('.html', '.htm')) else raw
            texts[rel] = text
            if rel.endswith(('.html', '.htm')):
                scan_html_rules(raw, rel)
            else:
                scan_text_data(text, rel)
        elif kind in ('image', 'asset', 'code'):
            if kind in ('image', 'asset'):
                check_binary(p, rel)
        else:
            add('中', '非常规文件类型', rel, '被服务目录中出现 %s 类型文件' % (os.path.splitext(p)[1] or '无扩展名'))

    # 接口级巡检（动态内容）
    check_api_endpoints()

    # 变更检测：仅对文本类文件
    changed = []
    changed_text = {}
    if os.path.exists(BASELINE):
        try:
            base = json.load(open(BASELINE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            base = {}
        for name, t in texts.items():
            old = base.get(name, '')
            if old != t:
                changed.append((name, len(old), len(t)))
                sm = difflib.SequenceMatcher(None, old, t)
                added = ''.join(t[j1:j2] for tag, _i1, _i2, j1, j2 in sm.get_opcodes()
                                if tag in ('insert', 'replace'))
                if added:
                    changed_text[name] = added[:800]
    os.makedirs(RECORDS, exist_ok=True)
    with open(BASELINE, 'w', encoding='utf-8') as fh:
        json.dump(texts, fh, ensure_ascii=False)

    # AI 判定层
    ai_notes = []
    conf = load_audit_conf()
    if conf.get('LLM_KEY') and issues:
        by_file = {}
        for level, kind, where, detail in issues:
            by_file.setdefault(where, []).append('%s/%s' % (kind, detail[:60]))
        calls = 0
        for rel, hits in list(by_file.items())[:4]:
            if calls >= 5:
                break
            verdict = judge('rule_hit', rel, {'rules': '; '.join(hits[:5]),
                                              'hidden': ' / '.join(hidden_by_page.get(rel, []))[:300],
                                              'excerpt': '; '.join(hits[:5])[:600]})
            calls += 1
            if rel in hard_risk_pages:
                verdict = {'verdict': 'risk', 'reason': '隐藏元素内含违禁词，规则优先（未采纳模型判断）'}
            if verdict:
                ai_notes.append((rel, hits[:3], verdict))
    elif conf.get('LLM_KEY') and changed and not issues:
        rel, old_n, new_n = changed[0]
        added = changed_text.get(rel, '')
        if len(added.strip()) >= 10:
            verdict = judge('change', rel, {'excerpt': '新增文字：' + added + '（字符数 %d -> %d）' % (old_n, new_n)})
            if verdict and verdict.get('verdict') != 'ok':
                ai_notes.append((rel, ['内容变更'], verdict))

    # 自动处置（默认演练，需 REMEDIATE_CONF 中 APPLY=1 才真正拦截）
    actions, apply_on = ([], False)
    if issues and ai_notes:
        actions, apply_on = remediate(ai_notes)

    # 报告
    today = datetime.now().strftime('%Y%m%d')
    report_path = os.path.join(RECORDS, 'content-audit-%s.txt' % today)
    lines = ['# 内容巡检报告', '',
             '- 检查时间：%s' % datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
             '- 巡检目录：%s' % '、'.join(served),
             '- 文件总数：%d，问题数：%d' % (len(files), len(issues)), '',
             '| 目录 | 文件数 |', '| --- | --- |']
    for d in served:
        n = sum(1 for f in files if f.startswith(d))
        lines.append('| %s | %d |' % (d, n))
    lines += ['', '| 文件类型 | 数量 |', '| --- | --- |']
    for k, v in sorted(type_stat.items(), key=lambda x: -x[1]):
        lines.append('| %s | %d |' % (k, v))
    if skipped_big:
        lines += ['', '说明：%d 个超过 %d MB 的文件仅记录大小，未做内容扫描。' % (skipped_big, MAX_SCAN_BYTES // 1024 // 1024)]
    if changed:
        lines += ['', '## 与上次基线相比有变化的文本文件', '',
                  '| 文件 | 原字符数 | 现字符数 |', '| --- | --- | --- |']
        for name, o, n in changed[:30]:
            lines.append('| %s | %d | %d |' % (name, o, n))
    if issues:
        lines += ['', '## 发现问题', '', '| 级别 | 类别 | 位置 | 说明 |', '| --- | --- | --- | --- |']
        for level, kind, where, detail in issues[:80]:
            lines.append('| %s | %s | %s | %s |' % (level, kind, where, detail.replace('|', '/')))
    else:
        lines += ['', '**结论：未发现风险内容。**']
    if actions:
        lines += ['', '## 自动处置' + ('（已生效）' if apply_on else '（演练模式）'), '',
                  '| 文件 | 动作 |', '| --- | --- |']
        for rel, act in actions:
            lines.append('| %s | %s |' % (rel, act.replace('|', '/')))
    if ai_notes:
        lines += ['', '## 大模型判定', '', '| 文件 | 触发项 | 判定 | 理由 |', '| --- | --- | --- | --- |']
        for rel, hits, verdict in ai_notes:
            lines.append('| %s | %s | %s | %s |' % (
                rel, '；'.join(hits)[:80], verdict.get('verdict', '?'),
                str(verdict.get('reason', ''))[:80].replace('|', '/')))
    report = '\n'.join(lines) + '\n'
    with open(report_path, 'w', encoding='utf-8') as fh:
        fh.write(report)
    print(report)

    # 即时告警只用于紧急情况：出现高等级问题，或模型判定 risk。
    # 其余（如未登记外链、广告法用词）留给每日 08:00 汇总，避免天天打扰。
    # 即时告警的唯一标准：出现「高」等级问题（违禁词、隐藏内容、脚本夹带）。
    # 广告法用词、「未登记外链」等中等级问题只在日报里体现——模型判定 risk 也不升级，
    # 否则一句正常文案里的极限用词就会立刻发信，失去"仅紧急才打扰"的意义。
    critical = any(level == '高' for level, _k, _w, _d in issues)
    if not issues:
        pass
    elif not critical:
        print('存在 %d 项非紧急问题，留给每日汇总邮件' % len(issues))
    else:
        # 找出可即时告警的路径（24h 内未告警过）
        fresh = []
        for _lv, _kd, _w, _d in issues:
            if _lv != '高':
                continue
            url = url_path_for(_w) if _w.startswith('skyinstrument/') else None
            key = url or _w
            if key and key not in fresh and not recently_alerted(key):
                fresh.append(key)
        applied = any('已拦截' in act for _r, act in actions)
        delegated = applied and not any('演练' in act for _r, act in actions)
        if not fresh:
            print('紧急问题已在 24 小时内告警过，只在日报中提示')
        elif delegated:
            print('已由应急处置发送即时告警（含回滚命令），巡检不再重复发信')
            for key in fresh:
                mark_alerted(key)
        else:
            send_mail(report, len(issues))
            for key in fresh:
                mark_alerted(key)
    sys.exit(1 if issues else 0)


def load_audit_conf():
    conf = {}
    if not os.path.exists(AUDIT_CONF):
        return conf
    for line in open(AUDIT_CONF, encoding='utf-8'):
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        conf[k.strip()] = v.strip()
    return conf


def judge(kind, page, payload):
    """调用大模型判断规则命中或内容变更的性质。失败返回 None，绝不阻塞巡检。"""
    conf = load_audit_conf()
    if not conf.get('LLM_KEY'):
        return None
    if kind == 'rule_hit':
        prompt = (
            '你是网站内容合规审核员。某文件触发了本地规则，请判断是否属于真实风险。\n'
            '判定要点：\n'
            '1. 出现在隐藏元素（display:none 等）中的推广文字、链接，几乎都是恶意注入，判 risk；\n'
            '2. 页面正文中的合规提示语、免责声明、禁止性举例，不应视为违规；\n'
            '3. 卫星轨道数据（JSON/CSV/3LE）中出现推广文案、外链，属于异常，判 risk；\n'
            '4. 只依据给出的实际文本判断，不要假设文件性质。\n'
            '文件：%s\n规则命中：%s\n隐藏元素内文本：%s\n命中片段：%s\n\n'
            '请只输出一行 JSON，不要解释：'
            '{"verdict":"risk|false_positive|needs_review","reason":"不超过40字的中文理由"}'
            % (page, payload['rules'], payload.get('hidden', '（无）'), payload['excerpt'])
        )
    else:
        prompt = (
            '你是网站内容合规审核员。某文件内容相对上次发生了变化，请判断是否引入违规内容'
            '（涉政、涉黄、涉赌、涉诈、夸大宣传、个人信息泄露、异常外链等）。\n'
            '文件：%s\n变更摘要：%s\n\n'
            '请只输出一行 JSON，不要解释：'
            '{"verdict":"ok|risk|needs_review","reason":"不超过40字的中文理由"}'
            % (page, payload['excerpt'])
        )
    body = json.dumps({
        'model': conf.get('LLM_MODEL', 'deepseek-chat'),
        'messages': [
            {'role': 'system', 'content': '你是严谨的网站内容合规审核员，只输出 JSON。'},
            {'role': 'user', 'content': prompt},
        ],
        'temperature': 0.1,
        'max_tokens': 200,
        'stream': False,
    }).encode('utf-8')
    req = urllib.request.Request(conf.get('LLM_ENDPOINT', 'https://api.deepseek.com/chat/completions'),
                                 data=body, method='POST')
    req.add_header('Content-Type', 'application/json')
    req.add_header('Authorization', 'Bearer ' + conf['LLM_KEY'])
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            data = json.loads(resp.read().decode('utf-8'))
        content = data['choices'][0]['message']['content'].strip()
        content = re.sub(r'^```(?:json)?|```$', '', content, flags=re.M).strip()
        m = re.search(r'\{.*\}', content, re.S)
        if not m:
            return {'verdict': 'needs_review', 'reason': '模型输出无法解析：' + content[:40]}
        return json.loads(m.group(0))
    except Exception as exc:  # noqa: BLE001
        print('大模型判定失败：%s: %s' % (type(exc).__name__, exc), file=sys.stderr)
        return None


def recently_alerted(rel):
    """同一路径 24 小时内是否已即时告警过。"""
    try:
        data = json.load(open(ALERT_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return False
    ts = data.get(rel)
    return bool(ts) and (time.time() - ts) < ALERT_COOLDOWN_H * 3600


def mark_alerted(rel):
    try:
        os.makedirs(os.path.dirname(ALERT_STATE), exist_ok=True)
        try:
            data = json.load(open(ALERT_STATE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            data = {}
        data[rel] = time.time()
        # 清理超过 7 天的记录，避免无限增长
        data = {k: v for k, v in data.items() if time.time() - v < 7 * 86400}
        with open(ALERT_STATE, 'w', encoding='utf-8') as fh:
            json.dump(data, fh)
    except Exception:  # noqa: BLE001
        pass


def remediation_enabled():
    if not os.path.exists(REMEDIATE_CONF):
        return False
    for line in open(REMEDIATE_CONF, encoding='utf-8'):
        line = line.strip()
        if line.startswith('APPLY='):
            return line.split('=', 1)[1].strip() == '1'
    return False


def url_path_for(rel):
    """把相对路径映射为可拦截的 URL 路径；镜像数据不自动处置。"""
    if rel.startswith('skyinstrument/website/current/'):
        return '/' + rel[len('skyinstrument/website/current/'):]
    return None


def remediate(ai_notes):
    """仅对「模型判定 risk 且可映射为站点路径」的项处置；镜像不自动拦截。"""
    actions = []
    apply = remediation_enabled()
    for rel, hits, verdict in ai_notes:
        if verdict.get('verdict') != 'risk':
            continue
        url = url_path_for(rel)
        if not url:
            actions.append((rel, '跳过自动处置（非站点路径）'))
            continue
        cmd = [INCIDENT_BIN, '--path', url, '--reason',
               '内容巡检：%s；模型判定 risk' % '；'.join(hits)[:60]]
        if apply:
            cmd.append('--apply')
        # A3：邮件收口——生效处置时由 incident 独发一封（含回滚命令）；
        # 演练模式或冷却期内，incident 不发信。
        if not apply or recently_alerted(rel):
            cmd.append('--no-mail')
        try:
            out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 universal_newlines=True, timeout=60)
            ok = out.returncode == 0
            actions.append((rel, ('已拦截 503' if apply else '演练通过（未生效）') if ok
                            else '处置失败：' + (out.stdout or '')[-120:]))
        except Exception as exc:  # noqa: BLE001
            actions.append((rel, '处置异常：%s' % exc))
    return actions, apply


def send_mail(report, count):
    if not os.path.exists(MAIL_CONF):
        print('未配置 %s，跳过发信' % MAIL_CONF, file=sys.stderr)
        return
    conf = {}
    for line in open(MAIL_CONF, encoding='utf-8'):
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        conf[k.strip()] = v.strip()
    try:
        import smtplib
        from email.header import Header
        from email.mime.text import MIMEText
        from email.mime.multipart import MIMEMultipart
        from email.utils import formataddr

        rows = ''.join(
            '<tr><td style="padding:6px 10px;border:1px solid #d0d7de">%s</td>'
            '<td style="padding:6px 10px;border:1px solid #d0d7de">%s</td>'
            '<td style="padding:6px 10px;border:1px solid #d0d7de">%s</td></tr>'
            % (lvl, kind, detail.replace('&', '&amp;').replace('<', '&lt;'))
            for lvl, kind, _where, detail in issues[:40])
        html_body = (
            '<div style="font-family:-apple-system,PingFang SC,Microsoft YaHei,sans-serif;'
            'max-width:760px;margin:0 auto;font-size:14px;color:#1f2328">'
            '<h2 style="margin:0 0 6px">星象仪 · 内容巡检告警</h2>'
            '<p style="margin:0 0 14px;color:#57606a;font-size:13px">检查时间：%s ｜ 发现问题 %d 项</p>'
            '<table style="border-collapse:collapse;width:100%%;font-size:13px">'
            '<thead><tr style="background:#f6f8fa">'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">级别</th>'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">类别</th>'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">说明</th>'
            '</tr></thead><tbody>%s</tbody></table>'
            '<p style="margin:14px 0 0;color:#57606a;font-size:12px">'
            '完整报告见服务器 %s</p></div>'
            % (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), count, rows,
               os.path.join(RECORDS, 'content-audit-' + datetime.now().strftime('%Y%m%d') + '.txt'))
        )
        msg = MIMEMultipart('alternative')
        msg.attach(MIMEText(report, 'plain', 'utf-8'))
        msg.attach(MIMEText(html_body, 'html', 'utf-8'))
        msg['Subject'] = Header('[星象仪告警] 内容巡检发现 %d 项问题' % count, 'utf-8')
        msg['From'] = formataddr(('星象仪巡检', conf['SMTP_USER']))
        msg['To'] = conf['MAIL_TO']
        port = int(conf.get('SMTP_PORT', '465'))
        if port == 465:
            server = smtplib.SMTP_SSL(conf['SMTP_HOST'], port, timeout=20)
        else:
            server = smtplib.SMTP(conf['SMTP_HOST'], port, timeout=20)
            server.starttls()
        server.login(conf['SMTP_USER'], conf['SMTP_PASS'])
        server.sendmail(conf['SMTP_USER'], [conf['MAIL_TO']], msg.as_string())
        server.quit()
        print('告警邮件已发送至 %s' % conf['MAIL_TO'])
    except Exception as exc:  # noqa: BLE001
        print('告警邮件发送失败：%s: %s' % (type(exc).__name__, exc), file=sys.stderr)


