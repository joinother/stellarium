def load_lexicon():
    """合并外部词库与内置兜底词表；排除层优先。

    返回 {类别: [词条...]}。外部词库缺失或损坏时退回内置词表，
    保证巡检永远有一份可用的规则。
    """
    merged = {k: list(v) for k, v in BLOCK_WORDS.items()}
    exclude = set()
    if os.path.exists(LEXICON_EXCLUDE):
        exclude = {l.strip() for l in open(LEXICON_EXCLUDE, encoding='utf-8')
                   if l.strip() and not l.startswith('#')}
    try:
        data = json.load(open(LEXICON, encoding='utf-8'))
        for cat, words in data.items():
            merged.setdefault(cat, [])
            keep = []
            for w in words:
                if w in exclude or len(w) > 30:
                    continue
                if all(ord(c) < 128 for c in w) and len(w) < 4:
                    continue      # 纯 ASCII 短词会与卫星编号撞车
                keep.append(w)
            merged[cat] = sorted(set(merged[cat]) | set(keep))
    except Exception:  # noqa: BLE001
        pass
    return merged


