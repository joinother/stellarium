def normalize(text):
    """归一化：全角转半角、繁转简、去掉空白与常见分隔符、小写。

    用于抓「博 彩」「博*彩」「博採」这类变体。因为去掉符号可能让相邻字
    拼出词条（如「颜色情况」含「色情」），变体命中一律按「中」等待复核处理。
    """
    t = text.translate(FULL2HALF)
    t = ''.join(TRAD2SIMP.get(ch, ch) for ch in t)
    t = NOISE_RE.sub('', t)
    return t.lower()


NORM_WORD_CACHE = {}


def normalized_word(w):
    if w not in NORM_WORD_CACHE:
        NORM_WORD_CACHE[w] = normalize(w)
    return NORM_WORD_CACHE[w]


def has_cjk(w):
    return any('\u4e00' <= ch <= '\u9fff' for ch in w)


def scan_text_data(text, rel):
    """对数据文件（JSON/CSV/3LE 等）执行规则检查。

    数据文件只匹配中文词条：卫星名、字段名大量使用英文缩写，
    "amateur""anal" 这类英文子串会把正常数据判成违规。
    """
    for cat, words in load_lexicon().items():
        for w in words:
            if not has_cjk(w):
                continue
            if w in text:
                idx = text.find(w)
                add('中', '违禁词/%s' % cat, rel,
                    '命中「%s」：…%s…' % (w, text[max(0, idx - 30):idx + 30]))
    for w in AD_WORDS:
        if w in text:
            idx = text.find(w)
            add('中', '广告法极限词', rel,
                '命中「%s」：…%s…' % (w, text[max(0, idx - 30):idx + 30]))
    for m in LINK_RE.finditer(text):
        host = re.sub(r'^https?://', '', m.group(1)).split('/')[0].split(':')[0].lower()
        if not any(host == d or host.endswith('.' + d) for d in ALLOWED_DOMAINS):
            add('中', '未登记外链', rel, m.group(1)[:120])
    # 数据文件里出现脚本标签属于异常
    for m in re.finditer(r'<script|<iframe|javascript:', text, re.I):
        add('高', '数据夹带脚本', rel, text[max(0, m.start() - 20):m.start() + 40])


def scan_large_text(path, rel):
    """超过阈值的文本文件：分块流式扫描，避免整文件读入内存。"""
    chunk = 1024 * 1024
    overlap = 256
    hit = 0
    prev = b''
    try:
        with open(path, 'rb') as fh:
            while True:
                buf = fh.read(chunk)
                if not buf:
                    break
                data = (prev + buf).decode('utf-8', 'replace')
                prev = buf[-overlap:]
                for cat, words in load_lexicon().items():
                    for w in words:
                        if w in data:
                            add('中', '违禁词/%s' % cat, rel, '大文件分块命中「%s」' % w)
                            hit += 1
                if hit > 20:
                    return
    except Exception as exc:  # noqa: BLE001
        add('中', '文件不可读', rel, str(exc)[:80])


def api_budget_used():
    try:
        data = json.load(open(API_BUDGET_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return 0
    now = time.time()
    return len([t for t in data.get('hits', []) if now - t < 3600])


def api_budget_consume():
    try:
        try:
            data = json.load(open(API_BUDGET_STATE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            data = {'hits': []}
        now = time.time()
        hits = [t for t in data.get('hits', []) if now - t < 3600]
        hits.append(now)
        data['hits'] = hits
        os.makedirs(os.path.dirname(API_BUDGET_STATE), exist_ok=True)
        json.dump(data, open(API_BUDGET_STATE, 'w', encoding='utf-8'))
    except Exception:  # noqa: BLE001
        pass


def api_endpoints():
    if os.path.exists(API_CONF):
        out = []
        for line in open(API_CONF, encoding='utf-8'):
            line = line.strip()
            if line and not line.startswith('#'):
                out.append(line)
        if out:
            return out
    return API_DEFAULT


def check_api_endpoints():
    """接口级巡检：动态内容不在磁盘上，只能抓响应来查。

    接口自身有频率限制（429），所以逐个请求并留间隔；遇到 429 先退避重试，
    仍失败则记为「接口限流」（低等级，不进即时告警），不当作内容问题。
    """
    used = api_budget_used()
    for idx, path in enumerate(api_endpoints()):
        # 预算不足时只探活 /healthz，其余留到下一轮，避免触发接口限流
        if used >= API_BUDGET_PER_HOUR and path != '/healthz':
            continue
        if idx:
            time.sleep(1.5)
        api_budget_consume()
        url = API_BASE + path
        try:
            req = urllib.request.Request(url, headers={'User-Agent': 'content-audit/1.0'})
            with urllib.request.urlopen(req, timeout=10) as resp:
                status = resp.status
                body = resp.read(API_MAX_BYTES)
        except urllib.error.HTTPError as exc:
            if exc.code == 429:
                time.sleep(3)
                try:
                    req2 = urllib.request.Request(url, headers={'User-Agent': 'content-audit/1.0'})
                    with urllib.request.urlopen(req2, timeout=10) as resp2:
                        body2 = resp2.read(API_MAX_BYTES)
                    scan_text_data(body2.decode('utf-8', 'replace'), path)
                    continue
                except Exception:  # noqa: BLE001
                    add('低', '接口限流', path, 'HTTP 429（退避重试仍失败，非内容问题）')
                    continue
            add('中', '接口异常', path, 'HTTP %s' % exc.code)
            continue
        except Exception as exc:  # noqa: BLE001
            add('中', '接口不可达', path, '%s' % str(exc)[:80])
            continue
        if status != 200:
            add('中', '接口状态异常', path, 'HTTP %s' % status)
        if len(body) >= API_MAX_BYTES:
            add('中', '接口响应过大', path, '超过 %d MB' % (API_MAX_BYTES // 1024 // 1024))
        text = body.decode('utf-8', 'replace')
        try:
            json.loads(text)
        except Exception:  # noqa: BLE001
            add('中', '接口响应非 JSON', path, text[:80])
        scan_text_data(text, path)


def visible_text(raw):
    s = re.sub(r'<script.*?</script>', ' ', raw, flags=re.S | re.I)
    s = re.sub(r'<style.*?</style>', ' ', s, flags=re.S | re.I)
    s = re.sub(r'<[^>]+>', ' ', s)
    s = htmllib.unescape(s)
    return re.sub(r'\s+', ' ', s).strip()


def scan_html_rules(raw, name):
    text = visible_text(raw)

    # 1 隐藏内容（同时抽取隐藏区域的文字，供 AI 与硬风险判定使用）
    w = None
    hidden_texts = []
    for m in HIDDEN_RE.finditer(raw):
        tail = raw[m.start():m.start() + 600]
        inner = re.sub(r'<[^>]+>', ' ', tail)
        inner = htmllib.unescape(re.sub(r'\s+', ' ', inner)).strip()
        if inner:
            hidden_texts.append(inner[:200])
        add('中', '隐藏内容', name, '发现隐藏元素：%s' % m.group(0)[:120])
    if hidden_texts:
        hidden_by_page[name] = hidden_texts

    # 2 违禁词
    lexicon = load_lexicon()
    hit_words = set()
    for cat, words in lexicon.items():
        for w in words:
            if w in text:
                hit_words.add(w)
                idx = text.find(w)
                add('中', '违禁词/%s' % cat, name, '命中「%s」：…%s…' % (w, text[max(0, idx-30):idx+30]))
                if any(w in ht for ht in hidden_texts):
                    hard_risk_pages.add(name)

    # 归一化后再匹配一次，抓空格/符号/繁体变体；这类命中按「中」等待复核
    norm_text = normalize(text)
    for cat, words in lexicon.items():
        for w in words:
            if w in hit_words or len(normalized_word(w)) < 2:
                continue
            nw = normalized_word(w)
            if nw and nw in norm_text:
                idx = norm_text.find(nw)
                add('中', '违禁词变体/%s' % cat, name,
                    '变体命中「%s」：…%s…' % (w, norm_text[max(0, idx - 20):idx + 20]))

    # 3 广告法极限词
    for w in AD_WORDS:
        if w in text:
            idx = text.find(w)
            add('中', '广告法极限词', name, '命中「%s」：…%s…' % (w, text[max(0, idx-30):idx+30]))

    # 4 外链白名单
    for m in LINK_RE.finditer(raw):
        url = m.group(1)
        host = re.sub(r'^https?://', '', url).split('/')[0].split(':')[0].lower()
        # 允许白名单域名及其子域（如 www.qt.io、docs.github.com）
        ok = any(host == d or host.endswith('.' + d) for d in ALLOWED_DOMAINS)
        if not ok:
            add('中', '未登记外链', name, url[:120])

    # 5 个人信息
    for m in PHONE_RE.finditer(text):
        add('高', '个人信息/手机号', name, m.group(0))
    for m in EMAIL_RE.finditer(text):
        if m.group(0) not in EMAIL_ALLOW:
            add('中', '个人信息/邮箱', name, m.group(0))

    # 6 脚本注入特征
    for m in SUSPICIOUS_RE.finditer(raw):
        add('中', '可疑标签', name, m.group(0)[:80])

    return text


def main():
    served = discover_served_dirs()
    if not served:
        served = [SITE_DIR]
    files = []
    for root_dir in served:
        for dirpath, _dirnames, filenames in os.walk(root_dir):
            for fn in sorted(filenames):
                p = os.path.join(dirpath, fn)
                if os.path.islink(p):
                    continue
                files.append(p)
                if len(files) >= MAX_FILES:
                    break
            if len(files) >= MAX_FILES:
                break
    files = sorted(set(files))

    texts = {}
    type_stat = {}
    hash_list = []
    skipped_big = 0

    for p in files:
        rel = os.path.relpath(p, os.path.dirname(served[0]) if len(served) == 1 else '/srv')
        ABS_BY_REL[rel] = p
        kind = classify(p)
        type_stat[kind] = type_stat.get(kind, 0) + 1
        try:
            size = os.path.getsize(p)
        except Exception:  # noqa: BLE001
            size = -1
        if size > MAX_SCAN_BYTES:
            if kind == 'text':
                scan_large_text(p, rel)      # 大文本流式扫描，不整体读入
                hash_list.append((rel, size, 'streamed'))
            else:
                skipped_big += 1
                hash_list.append((rel, size, 'skipped-big'))
            continue

        if kind == 'text':
            try:
                raw = open(p, encoding='utf-8', errors='replace').read()
            except Exception as exc:  # noqa: BLE001
                add('中', '文件不可读', rel, str(exc)[:80])
                continue
            text = visible_text(raw) if rel.endswith(('.html', '.htm')) else raw
            texts[rel] = text
            if rel.endswith(('.html', '.htm')):
                scan_html_rules(raw, rel)
            else:
                scan_text_data(text, rel)
        elif kind in ('image', 'asset', 'code'):
            if kind in ('image', 'asset'):
                check_binary(p, rel)
        else:
            add('中', '非常规文件类型', rel, '被服务目录中出现 %s 类型文件' % (os.path.splitext(p)[1] or '无扩展名'))

    # 接口级巡检（动态内容）
    check_api_endpoints()

    # 全站轮审：--sample N 时抽 N 个页面做整页 AI 审查（不依赖变更）
    sample_n = 0
    for i, a in enumerate(sys.argv):
        if a == '--sample' and i + 1 < len(sys.argv):
            try:
                sample_n = int(sys.argv[i + 1])
            except ValueError:
                sample_n = 0
    sampled = []
    if sample_n > 0 and load_audit_conf().get('LLM_KEY'):
        for p in sample_pages(served, sample_n):
            rel = os.path.relpath(p, os.path.dirname(served[0]) if len(served) == 1 else '/srv')
            ABS_BY_REL[rel] = p
            res = review_full_page(p, rel)
            sampled.append((rel, res))
            if res and res.get('verdict') == 'risk':
                add('中', '整页审查（AI）', rel,
                    '%s：…%s…' % (res.get('reason', ''), res.get('excerpt', '')))

    # 变更检测：仅对文本类文件
    changed = []
    changed_text = {}
    if os.path.exists(BASELINE):
        try:
            base = json.load(open(BASELINE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            base = {}
        for name, t in texts.items():
            old = base.get(name, '')
            if old != t:
                changed.append((name, len(old), len(t)))
                sm = difflib.SequenceMatcher(None, old, t)
                added = ''.join(t[j1:j2] for tag, _i1, _i2, j1, j2 in sm.get_opcodes()
                                if tag in ('insert', 'replace'))
                if added:
                    changed_text[name] = added[:800]
    os.makedirs(RECORDS, exist_ok=True)
    with open(BASELINE, 'w', encoding='utf-8') as fh:
        json.dump(texts, fh, ensure_ascii=False)

    # AI 判定层
    ai_notes = []
    conf = load_audit_conf()
    if conf.get('LLM_KEY') and issues:
        by_file = {}
        for level, kind, where, detail in issues:
            by_file.setdefault(where, []).append('%s/%s' % (kind, detail[:60]))
        calls = 0
        for rel, hits in list(by_file.items())[:6]:
            if calls >= 8:
                break
            verdict = judge('rule_hit', rel, {'rules': '; '.join(hits[:5]),
                                              'hidden': ' / '.join(hidden_by_page.get(rel, []))[:300],
                                              'excerpt': '; '.join(hits[:5])[:600]})
            calls += 1
            if rel in hard_risk_pages:
                verdict = {'verdict': 'risk', 'reason': '隐藏元素内含违禁词，规则优先（未采纳模型判断）'}
            if verdict:
                ai_notes.append((rel, hits[:3], verdict))
                # 由 AI 决定严重度：确认为风险则升为「高」（可即时告警/处置），
                # 判定为误报则降为「低」（只留档，不告警）
                v = verdict.get('verdict')
                if v == 'risk':
                    issues[:] = [(('高' if lv != '高' else lv), kd, w, dt) if w == rel else (lv, kd, w, dt)
                                 for lv, kd, w, dt in issues]
                elif v == 'false_positive':
                    issues[:] = [(('低' if lv != '低' else lv), kd, w, dt) if w == rel else (lv, kd, w, dt)
                                 for lv, kd, w, dt in issues]
    elif conf.get('LLM_KEY') and changed and not issues:
        # 词库未命中，但内容有变更：逐段交给模型自由审查（最多 3 段）
        calls = 0
        for rel, old_n, new_n in changed:
            if calls >= 3:
                break
            added = changed_text.get(rel, '')
            if len(added.strip()) < 10:
                continue
            verdict = judge_free(rel, added)
            calls += 1
            if not verdict:
                continue
            if verdict.get('verdict') == 'risk':
                issue_level = '高' if rel in hard_risk_pages else '中'
                add(issue_level, '疑似风险（AI 自由审查）', rel,
                    '%s：…%s…' % (verdict.get('reason', ''), added[:80]))
                ai_notes.append((rel, ['词库未命中，AI 自由审查'], verdict))
            elif verdict.get('verdict') == 'needs_review':
                ai_notes.append((rel, ['词库未命中，AI 待人工确认'], verdict))

    # 自动处置（默认演练，需 REMEDIATE_CONF 中 APPLY=1 才真正拦截）
    # 硬风险（隐藏元素内含违禁词）：该页所有命中升为「高」，可直接即时告警与处置
    if hard_risk_pages:
        issues[:] = [(('高' if w in hard_risk_pages else lv), kd, w, dt)
                     for lv, kd, w, dt in issues]

    # AI 不可用（未配置 / 预算耗尽）时，非硬风险的高等级命中降为「中」待复核，
    # 避免 AI 降级期间把"代理""网络"这类误报升级成即时告警。
    ai_unavailable = (not load_audit_conf().get('LLM_KEY')) or budget_left() <= 0
    if ai_unavailable:
        issues[:] = [(('中' if lv == '高' and w not in hard_risk_pages else lv), kd, w, dt)
                     for lv, kd, w, dt in issues]

    # 处置不依赖 AI：硬风险（隐藏元素内含违禁词）按规则直接处置。
    # AI 只对「非硬风险但被判 risk」的情形追加处置建议，模型不可用不影响兜底。
    actions, apply_on = ([], False)
    if issues:
        fallback_notes = []
        for page in sorted(hard_risk_pages):
            hit = [h for h in issues if h[2] == page][:3]
            fallback_notes.append((page, ['%s/%s' % (h[1], h[3][:40]) for h in hit],
                                  {'verdict': 'risk', 'reason': '隐藏元素含违禁词（规则判定）'}))
        for note in ai_notes:
            if note[0] not in hard_risk_pages and note[2].get('verdict') == 'risk':
                fallback_notes.append(note)
        if fallback_notes:
            actions, apply_on = remediate(fallback_notes)

    # 报告
    today = datetime.now().strftime('%Y%m%d')
    report_path = os.path.join(RECORDS, 'content-audit-%s.txt' % today)
    lines = ['# 内容巡检报告', '',
             '- 检查时间：%s' % datetime.now().strftime('%Y-%m-%d %H:%M:%S'),
             '- 巡检目录：%s' % '、'.join(served),
             '- 文件总数：%d，问题数：%d' % (len(files), len(issues)), '',
             '| 目录 | 文件数 |', '| --- | --- |']
    for d in served:
        n = sum(1 for f in files if f.startswith(d))
        lines.append('| %s | %d |' % (d, n))
    lines += ['', '| 文件类型 | 数量 |', '| --- | --- |']
    for k, v in sorted(type_stat.items(), key=lambda x: -x[1]):
        lines.append('| %s | %d |' % (k, v))
    if skipped_big:
        lines += ['', '说明：%d 个超过 %d MB 的文件仅记录大小，未做内容扫描。' % (skipped_big, MAX_SCAN_BYTES // 1024 // 1024)]
    if changed:
        lines += ['', '## 与上次基线相比有变化的文本文件', '',
                  '| 文件 | 原字符数 | 现字符数 |', '| --- | --- | --- |']
        for name, o, n in changed[:30]:
            lines.append('| %s | %d | %d |' % (name, o, n))
    if issues:
        lines += ['', '## 发现问题', '', '| 级别 | 类别 | 位置 | 说明 |', '| --- | --- | --- | --- |']
        for level, kind, where, detail in issues[:80]:
            lines.append('| %s | %s | %s | %s |' % (level, kind, where, detail.replace('|', '/')))
    else:
        lines += ['', '**结论：未发现风险内容。**']
    st = load_ai_state()
    ai_line = '正常' if st.get('last_ok') and not st.get('consecutive_fail') else (
        '降级（连续失败 %s 次）' % st.get('consecutive_fail') if st.get('consecutive_fail') else '未调用')
    _all, _day = load_usage()
    lines += ['', '## AI 用量（今日）', '',
              '- 调用：%d / %d 次' % (_day.get('calls', 0), AI_MAX_CALLS_PER_DAY),
              '- token：输入 %d，输出 %d' % (_day.get('prompt_tokens', 0), _day.get('completion_tokens', 0)),
              '- 估算费用：%.3f 元' % price_of(_day),
              '- 超预算拦截：%d 次，拒答：%d 次，失败：%d 次'
              % (_day.get('budget_hit', 0), _day.get('refused', 0), _day.get('failed', 0)),
              '', '## AI 判定层', '',
              '- 状态：%s' % ai_line,
              '- 最近成功：%s' % (time.strftime('%Y-%m-%d %H:%M', time.localtime(st['last_ok'])) if st.get('last_ok') else '无'),
              '- 最近失败：%s' % (st.get('last_reason', '') or '无'),
              '- 今日拒绝输出：%s 次' % st.get('refused_today', 0)]
    if sampled:
        lines += ['', '## 全站轮审（本次抽样 %d 页）' % len(sampled), '',
                  '| 页面 | 结论 | 理由 |', '| --- | --- | --- |']
        for rel, res in sampled:
            if not res:
                lines.append('| %s | 跳过 | 内容过短或不可读 |' % rel)
            else:
                lines.append('| %s | %s | %s |' % (rel, res.get('verdict'),
                                                   str(res.get('reason', ''))[:60]))
    if actions:
        lines += ['', '## 自动处置' + ('（已生效）' if apply_on else '（演练模式）'), '',
                  '| 文件 | 动作 |', '| --- | --- |']
        for rel, act in actions:
            lines.append('| %s | %s |' % (rel, act.replace('|', '/')))
    if ai_notes:
        lines += ['', '## 大模型判定', '', '| 文件 | 触发项 | 判定 | 理由 |', '| --- | --- | --- | --- |']
        for rel, hits, verdict in ai_notes:
            lines.append('| %s | %s | %s | %s |' % (
                rel, '；'.join(hits)[:80], verdict.get('verdict', '?'),
                str(verdict.get('reason', ''))[:80].replace('|', '/')))
    report = '\n'.join(lines) + '\n'
    with open(report_path, 'w', encoding='utf-8') as fh:
        fh.write(report)
    print(report)

    # 即时告警只用于紧急情况：出现高等级问题，或模型判定 risk。
    # 其余（如未登记外链、广告法用词）留给每日 08:00 汇总，避免天天打扰。
    # 即时告警的唯一标准：出现「高」等级问题（违禁词、隐藏内容、脚本夹带）。
    # 广告法用词、「未登记外链」等中等级问题只在日报里体现——模型判定 risk 也不升级，
    # 否则一句正常文案里的极限用词就会立刻发信，失去"仅紧急才打扰"的意义。
    critical = any(level == '高' for level, _k, _w, _d in issues)
    if not issues:
        pass
    elif not critical:
        print('存在 %d 项非紧急问题，留给每日汇总邮件' % len(issues))
    else:
        # 找出可即时告警的路径（24h 内未告警过）
        fresh = []
        for _lv, _kd, _w, _d in issues:
            if _lv != '高':
                continue
            url = url_path_for(_w) if _w.startswith('skyinstrument/') else None
            key = url or _w
            if key and key not in fresh and not recently_alerted(key):
                fresh.append(key)
        applied = any('已拦截' in act for _r, act in actions)
        delegated = applied and not any('演练' in act for _r, act in actions)
        if not fresh:
            print('紧急问题已在 24 小时内告警过，只在日报中提示')
        elif delegated:
            print('已由应急处置发送即时告警（含回滚命令），巡检不再重复发信')
            for key in fresh:
                mark_alerted(key)
        else:
            send_mail(report, len(issues))
            for key in fresh:
                mark_alerted(key)
    sys.exit(1 if issues else 0)


def judge_free(page, text):
    """词库未命中时的兜底审查：把变更文本交给模型判断是否引入风险。

    只在内容确有变更时调用，且每次巡检最多 3 段，控制成本。
    """
    conf = load_audit_conf()
    if not conf.get('LLM_KEY'):
        return None
    if budget_left() <= 0:
        usage_add(budget_hit=1)
        ai_record(False, '当日 AI 调用已达上限（%d 次）' % AI_MAX_CALLS_PER_DAY)
        print('AI 当日预算已用尽，退回纯规则判定', file=sys.stderr)
        return None
    prompt = (
        '你是网站内容合规审核员。下面是一个网站的页面中新增或修改的文字，'
        '词库没有命中，但仍可能存在词库覆盖不到的问题。\n'
        '请判断是否引入以下风险（任一即可判 risk）：\n'
        '1. 诱导下载、加微信/QQ 领福利、刷单返利等推广导流；\n'
        '2. 夸大或绝对化宣传（最准、第一、100%% 有效、包治等）；\n'
        '3. 隐藏的推广文案、赌博、色情、诈骗、办证贷款类内容；\n'
        '4. 泄露个人信息（手机号、身份证、住址、账号密钥）；\n'
        '5. 与本站（天文观测工具）定位明显不符的商业或垃圾内容。\n'
        '若属于正常的功能说明、隐私政策、开源致谢、天文科普，判 ok。\n'
        '文件：%s\n新增文字：%s\n\n'
        '请只输出一行 JSON，不要解释：'
        '{"verdict":"ok|risk|needs_review","reason":"不超过40字的中文理由"}'
        % (page, text[:1200])
    )
    body = json.dumps({
        'model': conf.get('LLM_MODEL', 'deepseek-chat'),
        'messages': [
            {'role': 'system', 'content': '你是严谨的网站内容合规审核员，只输出 JSON。'},
            {'role': 'user', 'content': prompt},
        ],
        'temperature': 0.1,
        'max_tokens': 200,
        'stream': False,
    }).encode('utf-8')
    req = urllib.request.Request(conf.get('LLM_ENDPOINT', 'https://api.deepseek.com/chat/completions'),
                                 data=body, method='POST')
    req.add_header('Content-Type', 'application/json')
    req.add_header('Authorization', 'Bearer ' + conf['LLM_KEY'])
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            data = json.loads(resp.read().decode('utf-8'))
        content = data['choices'][0]['message']['content'].strip()
        stripped = re.sub(r'^```(?:json)?|```$', '', content, flags=re.M).strip()
        m = re.search(r'\{.*\}', stripped, re.S)
        if not m:
            low = content.lower()
            if any(h.lower() in low for h in REFUSAL_HINTS):
                ai_record(True, '模型拒绝输出（内容过滤）', refused=True)
                return {'verdict': 'refused', 'reason': '模型拒绝输出'}
            ai_record(False, '自由审查输出无法解析')
            return None
        ai_record(True)
        u = data.get('usage') or {}
        usage_add(calls=1, prompt=int(u.get('prompt_tokens', 0)),
                  completion=int(u.get('completion_tokens', 0)))
        return json.loads(m.group(0))
    except Exception as exc:  # noqa: BLE001
        ai_record(False, '%s: %s' % (type(exc).__name__, exc))
        return None


SAMPLE_STATE = '/var/lib/skyinstrument/fullscan-state.json'


def sample_pages(served, count):
    """轮转选取待审页面，保证多天内覆盖全站。"""
    pages = []
    for root in served:
        for dp, _dn, fns in os.walk(root):
            for fn in sorted(fns):
                if fn.endswith(('.html', '.htm')):
                    pages.append(os.path.join(dp, fn))
    pages = sorted(set(pages))
    if not pages:
        return []
    try:
        data = json.load(open(SAMPLE_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        data = {'cursor': 0, 'reviewed': {}}
    cursor = int(data.get('cursor', 0)) % len(pages)
    picked = pages[cursor:cursor + count]
    if len(picked) < count:
        picked += pages[:count - len(picked)]
    data['cursor'] = (cursor + count) % len(pages)
    data['reviewed'] = data.get('reviewed', {})
    for p in picked:
        data['reviewed'][p] = time.strftime('%Y-%m-%d')
    try:
        os.makedirs(os.path.dirname(SAMPLE_STATE), exist_ok=True)
        json.dump(data, open(SAMPLE_STATE, 'w', encoding='utf-8'), ensure_ascii=False)
    except Exception:  # noqa: BLE001
        pass
    return picked


def review_full_page(abs_path, rel):
    """整页 AI 审查：分段送审，每页最多 3 段。返回 (verdict, reason, excerpt)。"""
    try:
        raw = open(abs_path, encoding='utf-8', errors='replace').read()
    except Exception:  # noqa: BLE001
        return None
    text = visible_text(raw)
    if len(text) < 40:
        return None
    chunk = 1200
    segments = [text[i:i + chunk] for i in range(0, min(len(text), chunk * 3), chunk)]
    for seg in segments:
        verdict = judge_free(rel, seg)
        if verdict and verdict.get('verdict') == 'risk':
            out = dict(verdict)
            out['excerpt'] = seg[:80]
            return out
    return {'verdict': 'ok', 'reason': '整页未发现风险'}


def load_audit_conf():
    conf = {}
    if not os.path.exists(AUDIT_CONF):
        return conf
    for line in open(AUDIT_CONF, encoding='utf-8'):
        line = line.strip()
        if not line or line.startswith('#') or '=' not in line:
            continue
        k, v = line.split('=', 1)
        conf[k.strip()] = v.strip()
    return conf


