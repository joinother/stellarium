def discover_served_dirs():
    """从 nginx 配置里解析 root / alias，自动覆盖现在与将来新增的被服务目录。"""
    dirs = []
    if os.path.exists(NGINX_CONF):
        for line in open(NGINX_CONF, encoding='utf-8', errors='replace'):
            line = line.strip()
            m = re.match(r'(root|alias)\s+([^;]+);', line)
            if not m:
                continue
            path = m.group(2).strip()
            if not path.startswith('/'):
                continue
            # alias 指向 /x/y/ 时取其目录本身；root 同
            if os.path.isdir(path):
                dirs.append(os.path.normpath(path))
    if os.path.isdir(SITE_DIR):
        dirs.append(os.path.normpath(SITE_DIR))
    # 去重，且去掉被其他目录包含的子目录（子目录会被递归覆盖）
    uniq = sorted(set(dirs))
    kept = []
    for d in uniq:
        if not any(d != k and d.startswith(k + os.sep) for k in uniq):
            kept.append(d)
    return kept


def classify(path):
    ext = os.path.splitext(path)[1].lower()
    if ext in CODE_EXT:
        return 'code'
    if ext in TEXT_EXT:
        return 'text'
    if ext in IMAGE_EXT:
        return 'image'
    if ext in OTHER_OK_EXT:
        return 'asset'
    return 'unexpected'


def check_binary(path, rel):
    """图片与资产：校验魔数，检查是否夹带脚本或可执行内容。"""
    ext = os.path.splitext(path)[1].lower()
    try:
        with open(path, 'rb') as fh:
            head = fh.read(4096)
    except Exception as exc:  # noqa: BLE001
        add('中', '文件不可读', rel, str(exc)[:80])
        return
    magic = {
        '.png': b'\x89PNG', '.jpg': b'\xff\xd8\xff', '.jpeg': b'\xff\xd8\xff',
        '.gif': b'GIF8', '.webp': b'RIFF', '.ico': b'\x00\x00\x01\x00',
        '.woff': b'wOFF', '.woff2': b'wOF2', '.ttf': b'\x00\x01\x00\x00',
    }.get(ext)
    if magic and not head.startswith(magic):
        add('中', '文件魔数不符', rel, '扩展名 %s 但内容不是该格式' % ext)
    low = head.lower()
    for sig in (b'<script', b'<?php', b'#!/'):
        if sig in low:
            add('高', '资产夹带脚本', rel, '在 %s 文件中发现 %s' % (ext, sig.decode()))


