        'max_tokens': 200,
        'stream': False,
    }).encode('utf-8')
    req = urllib.request.Request(conf.get('LLM_ENDPOINT', 'https://api.deepseek.com/chat/completions'),
                                 data=body, method='POST')
    req.add_header('Content-Type', 'application/json')
    req.add_header('Authorization', 'Bearer ' + conf['LLM_KEY'])
    try:
        with urllib.request.urlopen(req, timeout=40) as resp:
            data = json.loads(resp.read().decode('utf-8'))
        content = data['choices'][0]['message']['content'].strip()
        stripped = re.sub(r'^```(?:json)?|```$', '', content, flags=re.M).strip()
        m = re.search(r'\{.*\}', stripped, re.S)
        if not m:
            low = content.lower()
            if any(h.lower() in low for h in REFUSAL_HINTS):
                ai_record(True, '模型拒绝输出（内容过滤）', refused=True)
                usage_add(calls=1, refused=1)
                print('大模型拒绝输出（可能触发内容过滤），跳过判定', file=sys.stderr)
                return {'verdict': 'refused', 'reason': '模型拒绝输出，未参与判定'}
            ai_record(False, '输出无法解析：' + content[:80])
            return {'verdict': 'needs_review', 'reason': '模型输出无法解析：' + content[:40]}
        ai_record(True)
        u = data.get('usage') or {}
        usage_add(calls=1, prompt=int(u.get('prompt_tokens', 0)),
                  completion=int(u.get('completion_tokens', 0)))
        return json.loads(m.group(0))
    except Exception as exc:  # noqa: BLE001
        ai_record(False, '%s: %s' % (type(exc).__name__, exc))
        usage_add(calls=1, failed=1)
        print('大模型判定失败：%s: %s' % (type(exc).__name__, exc), file=sys.stderr)
        return None


def _today():
    return time.strftime('%Y-%m-%d')


def load_usage():
    try:
        data = json.load(open(AI_USAGE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        data = {}
    day = data.get(_today())
    if not day:
        day = {'calls': 0, 'prompt_tokens': 0, 'completion_tokens': 0,
               'refused': 0, 'failed': 0, 'budget_hit': 0}
    return data, day


def save_usage(data, day):
    data[_today()] = day
    # 只保留最近 90 天
    keep = sorted(data.keys())[-90:]
    data = {k: data[k] for k in keep}
    try:
        os.makedirs(os.path.dirname(AI_USAGE), exist_ok=True)
        json.dump(data, open(AI_USAGE, 'w', encoding='utf-8'), ensure_ascii=False, indent=2)
    except Exception:  # noqa: BLE001
        pass


def usage_add(calls=0, prompt=0, completion=0, refused=0, failed=0, budget_hit=0):
    data, day = load_usage()
    day['calls'] += calls
    day['prompt_tokens'] += prompt
    day['completion_tokens'] += completion
    day['refused'] += refused
    day['failed'] += failed
    day['budget_hit'] += budget_hit
    save_usage(data, day)


def budget_left():
    _data, day = load_usage()
    return max(0, AI_MAX_CALLS_PER_DAY - int(day.get('calls', 0)))


def price_of(day):
    """按可配置单价估算当天花费（元）。"""
    conf = load_audit_conf()
    try:
        pin = float(conf.get('LLM_PRICE_IN_PER_M', '2'))
        pout = float(conf.get('LLM_PRICE_OUT_PER_M', '8'))
    except ValueError:
        pin, pout = 2.0, 8.0
    return (day.get('prompt_tokens', 0) / 1e6 * pin +
            day.get('completion_tokens', 0) / 1e6 * pout)


def load_ai_state():
    try:
        return json.load(open(AI_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return {'last_ok': 0, 'last_error': 0, 'last_reason': '', 'consecutive_fail': 0,
                'refused_today': 0, 'today': ''}


def save_ai_state(state):
    try:
        os.makedirs(os.path.dirname(AI_STATE), exist_ok=True)
        with open(AI_STATE, 'w', encoding='utf-8') as fh:
            json.dump(state, fh, ensure_ascii=False)
    except Exception:  # noqa: BLE001
        pass


def ai_record(ok, reason='', refused=False):
    st = load_ai_state()
    today = time.strftime('%Y-%m-%d')
    if st.get('today') != today:
        st['today'] = today
        st['refused_today'] = 0
    if ok:
        st['last_ok'] = time.time()
        st['consecutive_fail'] = 0
    else:
        st['last_error'] = time.time()
        st['last_reason'] = reason[:200]
        st['consecutive_fail'] = int(st.get('consecutive_fail', 0)) + 1
    if refused:
        st['refused_today'] = int(st.get('refused_today', 0)) + 1
    save_ai_state(st)


def recently_alerted(rel):
    """同一路径 24 小时内是否已即时告警过。"""
    try:
        data = json.load(open(ALERT_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return False
    ts = data.get(rel)
    return bool(ts) and (time.time() - ts) < ALERT_COOLDOWN_H * 3600


def mark_alerted(rel):
    try:
        os.makedirs(os.path.dirname(ALERT_STATE), exist_ok=True)
        try:
            data = json.load(open(ALERT_STATE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            data = {}
        data[rel] = time.time()
        # 清理超过 7 天的记录，避免无限增长
        data = {k: v for k, v in data.items() if time.time() - v < 7 * 86400}
        with open(ALERT_STATE, 'w', encoding='utf-8') as fh:
            json.dump(data, fh)
    except Exception:  # noqa: BLE001
        pass


def remediation_enabled():
    if not os.path.exists(REMEDIATE_CONF):
        return False
    for line in open(REMEDIATE_CONF, encoding='utf-8'):
        line = line.strip()
        if line.startswith('APPLY='):
            return line.split('=', 1)[1].strip() == '1'
    return False


def served_url_map():
    """从 nginx 配置解析「目录 -> URL 前缀」。

    支持 root 与 alias 两种写法：alias 记在 location 内的前缀上，
    root 一律以 / 为前缀。以后新增 location/alias 无需改代码即可纳入处置。
    """
    mapping = []
    if not os.path.exists(NGINX_CONF):
        return mapping
    prefix = '/'
    for raw in open(NGINX_CONF, encoding='utf-8', errors='replace'):
        line = raw.strip()
        m = re.match(r'location\s+(?:[=~^*\s]*)(\S+)\s*\{', line)
        if m and m.group(1).startswith('/'):
            prefix = m.group(1)
            if not prefix.endswith('/'):
                prefix += '/'
            continue
        m = re.match(r'alias\s+([^;]+);', line)
        if m:
            d = os.path.normpath(m.group(1).strip()) + '/'
            mapping.append((d, prefix))
            continue
        m = re.match(r'root\s+([^;]+);', line)
        if m:
            d = os.path.normpath(m.group(1).strip()) + '/'
            mapping.append((d, '/'))
            continue
        if line == '}':
            prefix = '/'
    # 长目录优先，避免 /srv/a 抢先匹配 /srv/a/b
    mapping.sort(key=lambda x: -len(x[0]))
    return mapping


ABS_BY_REL = {}


def url_path_for(rel):
    """把巡检里的相对路径映射为可拦截的 URL；未在 nginx 暴露的资源返回 None。"""
    abs_path = ABS_BY_REL.get(rel)
    if not abs_path:
        return None
    for d, prefix in served_url_map():
        if abs_path.startswith(d):
            return prefix + abs_path[len(d):]
    return None


def remediate_budget_left():
    """当天还剩几次真实拦截额度。"""
    try:
        data = json.load(open(REMEDIATE_STATE, encoding='utf-8'))
    except Exception:  # noqa: BLE001
        return REMEDIATE_MAX_PER_DAY
    today = time.strftime('%Y-%m-%d')
    if data.get('day') != today:
        return REMEDIATE_MAX_PER_DAY
    return max(0, REMEDIATE_MAX_PER_DAY - int(data.get('count', 0)))


def remediate_consume():
    try:
        os.makedirs(os.path.dirname(REMEDIATE_STATE), exist_ok=True)
        today = time.strftime('%Y-%m-%d')
        try:
            data = json.load(open(REMEDIATE_STATE, encoding='utf-8'))
        except Exception:  # noqa: BLE001
            data = {}
        if data.get('day') != today:
            data = {'day': today, 'count': 0}
        data['count'] = int(data.get('count', 0)) + 1
        json.dump(data, open(REMEDIATE_STATE, 'w', encoding='utf-8'))
    except Exception:  # noqa: BLE001
        pass


def remediate(ai_notes):
    """仅对「模型判定 risk 且可映射为站点路径」的项处置；镜像不自动拦截。"""
    actions = []
    apply = remediation_enabled()
    for rel, hits, verdict in ai_notes:
        if verdict.get('verdict') != 'risk':
            continue
        url = url_path_for(rel)
        if not url:
            actions.append((rel, '跳过自动处置（非站点路径）'))
            continue
        # 已在拦截状态就不再重复加规则，避免 nginx 片段堆积
        try:
            conf_text = open('/etc/skyinstrument-website/conf.d/incident.conf',
                             encoding='utf-8').read()
        except Exception:  # noqa: BLE001
            conf_text = ''
        if ('location = %s {' % url) in conf_text:
            actions.append((rel, '已处于拦截状态，无需重复处置'))
            continue
        if apply and remediate_budget_left() <= 0:
            actions.append((rel, '今日拦截额度已用尽（%d 次），仅告警' % REMEDIATE_MAX_PER_DAY))
            continue
        cmd = [INCIDENT_BIN, '--path', url, '--reason',
               '内容巡检：%s；模型判定 risk' % '；'.join(hits)[:60]]
        if apply:
            cmd.append('--apply')
            remediate_consume()
        # A3：邮件收口——生效处置时由 incident 独发一封（含回滚命令）；
        # 演练模式或冷却期内，incident 不发信。
        if not apply or recently_alerted(rel):
            cmd.append('--no-mail')
        try:
            out = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                 universal_newlines=True, timeout=60)
            ok = out.returncode == 0
            actions.append((rel, ('已拦截 503' if apply else '演练通过（未生效）') if ok
                            else '处置失败：' + (out.stdout or '')[-120:]))
        except Exception as exc:  # noqa: BLE001
            actions.append((rel, '处置异常：%s' % exc))
    return actions, apply


def send_mail(report, count):
    try:
        rows = ''.join(
            '<tr><td style="padding:6px 10px;border:1px solid #d0d7de">%s</td>'
            '<td style="padding:6px 10px;border:1px solid #d0d7de">%s</td>'
            '<td style="padding:6px 10px;border:1px solid #d0d7de">%s</td></tr>'
            % (lvl, kind, detail.replace('&', '&amp;').replace('<', '&lt;'))
            for lvl, kind, _where, detail in issues[:40])
        html_body = (
            '<div style="font-family:-apple-system,PingFang SC,Microsoft YaHei,sans-serif;'
            'max-width:760px;margin:0 auto;font-size:14px;color:#1f2328">'
            '<h2 style="margin:0 0 6px">星象仪 · 内容巡检告警</h2>'
            '<p style="margin:0 0 14px;color:#57606a;font-size:13px">检查时间：%s ｜ 发现问题 %d 项</p>'
            '<table style="border-collapse:collapse;width:100%%;font-size:13px">'
            '<thead><tr style="background:#f6f8fa">'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">级别</th>'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">类别</th>'
            '<th style="padding:8px 10px;border:1px solid #d0d7de;text-align:left">说明</th>'
            '</tr></thead><tbody>%s</tbody></table>'
            '<p style="margin:14px 0 0;color:#57606a;font-size:12px">'
            '完整报告见服务器 %s</p></div>'
            % (datetime.now().strftime('%Y-%m-%d %H:%M:%S'), count, rows,
               os.path.join(RECORDS, 'content-audit-' + datetime.now().strftime('%Y%m%d') + '.txt'))
        )
        import tempfile
        import subprocess as _sp
        tf = tempfile.NamedTemporaryFile('w', suffix='.txt', delete=False, encoding='utf-8')
        tf.write(report or '')
        tf.close()
        hf = tempfile.NamedTemporaryFile('w', suffix='.html', delete=False, encoding='utf-8')
        hf.write(html_body or '')
        hf.close()
        try:
            r = _sp.run([NOTIFY, '--level', 'critical',
                         '--subject', '[星象仪告警] 内容巡检发现 %d 项问题' % count,
                         '--text-file', tf.name, '--html-file', hf.name],
                        stdout=_sp.PIPE, stderr=_sp.STDOUT, universal_newlines=True, timeout=60)
            print((r.stdout or '').strip())
        finally:
            for _p in (tf.name, hf.name):
                if os.path.exists(_p):
                    os.unlink(_p)
    except Exception as exc:  # noqa: BLE001
        print('告警发送失败：%s: %s' % (type(exc).__name__, exc), file=sys.stderr)


