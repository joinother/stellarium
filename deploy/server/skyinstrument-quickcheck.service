[Unit]
Description=Skyinstrument lightweight file change watcher
Documentation=file:/srv/skyinstrument/security-records/00-README.md
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/flock -n /var/lib/skyinstrument/quickcheck.lock /usr/local/sbin/skyinstrument-quickcheck
Nice=19
CPUQuota=20%
IOSchedulingClass=idle
