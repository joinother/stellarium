[Unit]
Description=SkyInstrument online-data mirror refresh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=tle-mirror
Group=tle-mirror
WorkingDirectory=/opt/tle-mirror
ExecStart=/opt/tle-mirror/run-mirror.sh
TimeoutStartSec=900
Nice=10
UMask=0022
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/tle-mirror
MemoryHigh=192M
MemoryMax=256M
CPUQuota=50%
TasksMax=32
LimitNOFILE=256
