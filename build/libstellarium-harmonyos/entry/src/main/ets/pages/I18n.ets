// ═══════════════════════════════════════════════════════════════
// I18n 主类
// ═══════════════════════════════════════════════════════════════



export class I18n {
  private static systemLanguageTag(lang: LangCode): string {
    if (lang === 'zh_CN') return 'zh-Hans'
    if (lang === 'zh_HK') return 'zh-Hant-HK'
    if (lang === 'zh_TW') return 'zh-Hant-TW'
    return lang.replace(/_/g, '-')
  }

  static systemLanguage(): LangCode {
    let raw = ''
    try {
      const preferred = i18n.System.getAppPreferredLanguage()
      if (preferred.length > 0 && preferred !== 'default') raw = preferred
    } catch (_err) {
      raw = ''
    }
    try {
      if (raw.length === 0) raw = i18n.getSystemLocale()
      const normalized = raw.replace(/-/g, '_')
      const lower = normalized.toLowerCase()
      if (lower.startsWith('zh')) {
        if (lower.includes('_hk') || lower.includes('_mo')) {
          return 'zh_HK'
        }
        if (lower.includes('hant') || lower.includes('_tw')) {
          return 'zh_TW'
        }
        return 'zh_CN'
      }
      return I18n.fromStellariumCode(normalized)
    } catch (_err) {
      return 'zh_CN'
    }
  }

  // Read current language from AppStorage on every call, not a cached static.
  // This ensures the language is always in sync with the reactive UI state
  // (driven by @StorageLink('i18nLang') in the component).
  private static get lang(): LangCode {
    const stored = AppStorage.get<LangCode>('i18nLang')
    return stored ?? 'zh_CN'
  }

  // 设置当前语言（同时通知 AppStorage 触发 UI 重渲染）
  static setLanguage(lang: LangCode): void {
    try {
      i18n.System.setAppPreferredLanguage(I18n.systemLanguageTag(lang))
    } catch (_err) {
      // Older HarmonyOS releases may not expose app language persistence.
    }
    AppStorage.setOrCreate('i18nLang', lang)
  }

  // 获取当前语言
  static getLanguage(): LangCode {
    return I18n.lang
  }

  // Chinese UI variants share the project's official geographic terminology.
  // Script variants remain the responsibility of the upstream Qt catalogs.
  static isChineseLanguage(): boolean {
    return I18n.lang === 'zh_CN' || I18n.lang === 'zh_HK' || I18n.lang === 'zh_TW'
  }

  // 从 Stellarium 语言代码转换（C++ 侧用的代码可能不同）
  static fromStellariumCode(code: string): LangCode {
    const map: Record<string, LangCode> = {
      'ar': 'ar', 'ar_SA': 'ar', 'bn': 'bn', 'cs': 'cs', 'da': 'da',
      'de': 'de', 'de_DE': 'de', 'el': 'el', 'en': 'en', 'en_US': 'en',
      'es': 'es', 'es_ES': 'es', 'fa': 'fa', 'fi': 'fi', 'fr': 'fr',
      'fr_FR': 'fr', 'gu': 'gu', 'he': 'he', 'hi': 'hi', 'hr': 'hr',
      'hu': 'hu', 'id': 'id', 'it': 'it', 'ja': 'ja', 'ja_JP': 'ja',
      'ko': 'ko', 'ko_KR': 'ko', 'ml': 'ml', 'mr': 'mr', 'ms': 'ms',
      'nb': 'nb', 'ne': 'ne', 'nl': 'nl', 'nl_NL': 'nl', 'pl': 'pl',
      'pl_PL': 'pl', 'pt': 'pt', 'pt_BR': 'pt_BR', 'ro': 'ro', 'ru': 'ru',
      'ru_RU': 'ru', 'si': 'si', 'sk': 'sk', 'sl': 'sl', 'sv': 'sv',
      'ta': 'ta', 'te': 'te', 'th': 'th', 'uk': 'uk', 'vi': 'vi',
      'zh_CN': 'zh_CN', 'zh': 'zh_CN', 'zh_HK': 'zh_HK', 'zh_MO': 'zh_HK',
      'zh_TW': 'zh_TW',
    }
    const normalized = code.replace(/-/g, '_')
    try {
      const supportedLocales = SUPPORTED_LANGUAGES.map((language: string) => language.replace(/_/g, '-'))
      const bestMatch = i18n.I18NUtil.getBestMatchLocale(normalized.replace(/_/g, '-'), supportedLocales)
      if (bestMatch.length > 0) {
        const matched = bestMatch.replace(/-/g, '_')
        const exact = map[matched]
        if (exact) return exact
        const languageOnly = map[matched.split('_')[0]]
        if (languageOnly) return languageOnly
      }
    } catch (_err) {
      // Older system versions use the explicit mapping below.
    }
    return map[normalized] ?? map[normalized.split('_')[0]] ?? 'en'
  }

  // 转换为 Stellarium 语言代码（发给 C++ setLanguage 命令）
  static toStellariumCode(): string {
    return I18n.lang
  }

  // Country and region names are supplied by HarmonyOS instead of a second
  // application-maintained translation catalog. Chinese follows the project's
  // official terminology table at the call site.
  static displayCountry(countryCode: string, fallback: string): string {
    if (I18n.isChineseLanguage()) return fallback
    try {
      const localized = i18n.System.getDisplayCountry(
        countryCode,
        I18n.toStellariumCode().replace(/_/g, '-'),
        true
      )
      return localized.length > 0 ? localized : fallback
    } catch (_err) {
      return fallback
    }
  }

  // 通用翻译函数
  static t(key: string): string {
    const entry = UI_STRINGS[key]
    if (!entry) return key
    return entry[I18n.lang] ?? entry['en'] ?? key
  }

  static format(key: string, values: string[]): string {
    let text = I18n.t(key)
    for (let index = 0; index < values.length; index++) {
      text = text.replace('%' + (index + 1).toString(), values[index])
    }
    return text
  }

  // 天体类型翻译（C++ 返回的英文类型名，支持复合类型如 "double star, pulsating variable star"）
  static objectType(en: string): string {
    // 先尝试精确匹配
    const entry = OBJECT_TYPES[en]
    if (entry) {
      return entry[I18n.lang] ?? entry['en'] ?? en
    }
    // 复合类型：按逗号分割，逐段翻译
    if (en.indexOf(',') >= 0) {
      const parts = en.split(',')
      const translatedParts: string[] = []
      for (let i = 0; i < parts.length; i++) {
        const part = parts[i].trim()
        // 先尝试原始大小写
        const e1 = OBJECT_TYPES[part]
        if (e1) {
          translatedParts.push(e1[I18n.lang] ?? e1['en'] ?? part)
          continue
        }
        // 再尝试首字母大写
        const cap = part.charAt(0).toUpperCase() + part.slice(1)
        const e2 = OBJECT_TYPES[cap]
        if (e2) {
          translatedParts.push(e2[I18n.lang] ?? e2['en'] ?? part)
          continue
        }
        // 无法翻译，保留原文（可能已经是当前语言）
        translatedParts.push(part)
      }
      return translatedParts.join(', ')
    }
    // 尝试首字母大写
    const capKey = en.charAt(0).toUpperCase() + en.slice(1)
    const capEntry = OBJECT_TYPES[capKey]
    if (capEntry) {
      return capEntry[I18n.lang] ?? capEntry['en'] ?? en
    }
    return en
  }

  // 卫星分组翻译
  static satGroup(en: string): string {
    const entry = SAT_GROUPS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 插件名称翻译
  static pluginName(en: string): string {
    const entry = PLUGIN_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 地景名称翻译
  static landscapeName(en: string): string {
    const entry = LANDSCAPE_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 投影方式名称翻译
  static projectionName(en: string): string {
    const entry = PROJECTION_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 投影方式功能说明
  static projectionDesc(en: string): string {
    const entry = PROJECTION_DESC[en]
    if (!entry) return ''
    return entry[I18n.lang] ?? entry['en'] ?? ''
  }

  // 灵敏度翻译
  static sensitivity(en: string): string {
    const entry = SENSITIVITY[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 追踪状态翻译
  static trackStatus(en: string): string {
    const entry = TRACK_STATUS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 选中状态翻译
  static selectedStatus(en: string): string {
    const entry = SELECTED_STATUS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 富文本翻译（替换英文短语为当前语言）
  static richText(text: string): string {
    if (!text || text.length === 0) return ''
    let out: string = text
    // 按短语长度降序排列，避免短短语先替换导致长短语无法匹配
    const keys = Object.keys(RICH_PHRASES).sort((a, b) => b.length - a.length)
    for (const en of keys) {
      const entry = RICH_PHRASES[en]
      const translated = entry[I18n.lang] ?? entry['en'] ?? en
      if (translated !== en) {
        out = out.replace(new RegExp(en, 'gi'), translated)
      }
    }
    return out
  }
}
