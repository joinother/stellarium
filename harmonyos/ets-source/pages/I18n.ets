export class I18n {
  // Read current language from AppStorage on every call, not a cached static.
  // This ensures the language is always in sync with the reactive UI state
  // (driven by @StorageLink('i18nLang') in the component).
  private static get lang(): LangCode {
    const stored = AppStorage.get<LangCode>('i18nLang')
    return stored ?? 'zh_CN'
  }

  // 设置当前语言（同时通知 AppStorage 触发 UI 重渲染）
  static setLanguage(lang: LangCode): void {
    AppStorage.setOrCreate('i18nLang', lang)
  }

  // 获取当前语言
  static getLanguage(): LangCode {
    return I18n.lang
  }

  // 从 Stellarium 语言代码转换（C++ 侧用的代码可能不同）
  static fromStellariumCode(code: string): LangCode {
    const map: Record<string, LangCode> = {
      'en': 'en', 'en_US': 'en',
      'zh_CN': 'zh_CN', 'zh': 'zh_CN',
      'zh_TW': 'zh_TW', 'zh_HK': 'zh_TW',
      'ja': 'ja', 'ja_JP': 'ja',
      'ko': 'ko', 'ko_KR': 'ko',
      'fr': 'fr', 'fr_FR': 'fr',
      'de': 'de', 'de_DE': 'de',
      'es': 'es', 'es_ES': 'es',
      'ru': 'ru', 'ru_RU': 'ru',
      'pt': 'pt', 'pt_BR': 'pt',
      'it': 'it', 'it_IT': 'it',
      'nl': 'nl', 'nl_NL': 'nl',
      'pl': 'pl', 'pl_PL': 'pl',
      'tr': 'tr', 'tr_TR': 'tr',
      'ar': 'ar', 'ar_SA': 'ar',
      'hi': 'hi', 'hi_IN': 'hi',
      'th': 'th', 'th_TH': 'th',
      'vi': 'vi', 'vi_VN': 'vi',
      'id': 'id', 'id_ID': 'id',
      'uk': 'uk', 'uk_UA': 'uk',
      'sv': 'sv', 'sv_SE': 'sv',
    }
    return map[code] ?? 'en'
  }

  // 转换为 Stellarium 语言代码（发给 C++ setLanguage 命令）
  static toStellariumCode(): string {
    return I18n.lang
  }

  // 通用翻译函数
  static t(key: string): string {
    const entry = UI_STRINGS[key]
    if (!entry) return key
    return entry[I18n.lang] ?? entry['en'] ?? key
  }

  // 天体类型翻译（C++ 返回的英文类型名，支持复合类型如 "double star, pulsating variable star"）
  static objectType(en: string): string {
    // 先尝试精确匹配
    const entry = OBJECT_TYPES[en]
    if (entry) {
      return entry[I18n.lang] ?? entry['en'] ?? en
    }
    // 复合类型：按逗号分割，逐段翻译
    if (en.indexOf(',') >= 0) {
      const parts = en.split(',')
      const translatedParts: string[] = []
      for (let i = 0; i < parts.length; i++) {
        const part = parts[i].trim()
        // 先尝试原始大小写
        const e1 = OBJECT_TYPES[part]
        if (e1) {
          translatedParts.push(e1[I18n.lang] ?? e1['en'] ?? part)
          continue
        }
        // 再尝试首字母大写
        const cap = part.charAt(0).toUpperCase() + part.slice(1)
        const e2 = OBJECT_TYPES[cap]
        if (e2) {
          translatedParts.push(e2[I18n.lang] ?? e2['en'] ?? part)
          continue
        }
        // 无法翻译，保留原文（可能已经是当前语言）
        translatedParts.push(part)
      }
      return translatedParts.join(', ')
    }
    // 尝试首字母大写
    const capKey = en.charAt(0).toUpperCase() + en.slice(1)
    const capEntry = OBJECT_TYPES[capKey]
    if (capEntry) {
      return capEntry[I18n.lang] ?? capEntry['en'] ?? en
    }
    return en
  }

  // Constellation abbreviation (IAU 3-letter) → full name
  static constellationAbbr(abbr: string): string {
    const entry = CONSTELLATION_ABBR[abbr]
    if (!entry) return abbr
    return entry[I18n.lang] ?? entry['en'] ?? abbr
  }

  // Constellation full English name → localized name (reverse lookup)
  static constellationFullName(name: string): string {
    if (!name || name.length === 0) { return name }
    const lower = name.toLowerCase()
    for (const abbr of Object.keys(CONSTELLATION_ABBR)) {
      const entry = CONSTELLATION_ABBR[abbr]
      if (entry['en'].toLowerCase() === lower) {
        return entry[I18n.lang] ?? entry['en'] ?? name
      }
    }
    return name
  }

  // 行星名称翻译
  static planetName(en: string): string {
    const entry = PLANET_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 卫星分组翻译
  static satGroup(en: string): string {
    const entry = SAT_GROUPS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 插件名称翻译
  static pluginName(en: string): string {
    const entry = PLUGIN_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 地景名称翻译
  static landscapeName(en: string): string {
    const entry = LANDSCAPE_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 灵敏度翻译
  static sensitivity(en: string): string {
    const entry = SENSITIVITY[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 追踪状态翻译
  static trackStatus(en: string): string {
    const entry = TRACK_STATUS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 选中状态翻译
  static selectedStatus(en: string): string {
    const entry = SELECTED_STATUS[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 恒星名称翻译
  static starName(en: string): string {
    const entry = STAR_NAMES[en]
    if (!entry) return en
    return entry[I18n.lang] ?? entry['en'] ?? en
  }

  // 富文本翻译（替换英文短语为当前语言）
  static richText(text: string): string {
    if (!text || text.length === 0) return ''
    let out: string = text
    // 按短语长度降序排列，避免短短语先替换导致长短语无法匹配
    const keys = Object.keys(RICH_PHRASES).sort((a, b) => b.length - a.length)
    for (const en of keys) {
      const entry = RICH_PHRASES[en]
      const translated = entry[I18n.lang] ?? entry['en'] ?? en
      if (translated !== en) {
        out = out.replace(new RegExp(en, 'gi'), translated)
      }
    }
    return out
  }
}
