export function notificationText(value: string, language: string = I18n.getLanguage()): string {
  const chinese = language.toLowerCase().startsWith('zh')
  for (const entry of NOTIFICATION_TEXT) {
    if (value === entry[0] || value === entry[1]) return chinese ? entry[0] : entry[1]
  }
  return value
}
