{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/qabilitystage/QAbilityStage.ets",
    "description": "$string:module_desc",
    "mainElement": "QAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "easyGo": "$profile:easy_go",
    "metadata": [
      {
        "name": "appgallery_privacy_hosted",
        "value": "1"
      },
      {
        "name": "appgallery_privacy_link_privacy_statement",
        "value": "https://agreement-drcn.hispace.dbankcloud.cn/index.html?lang=zh&agreementId=2004631976732052288"
      }
    ],
    "abilities": [
      {
        "name": "QAbility",
        "srcEntry": "./ets/qability/QAbility.ets",
        "launchType": "singleton",
        "metadata": [
          { "name": "enable.remove.starting.window", "value": "true" }
        ],
        "supportWindowMode": [
          "fullscreen",
          "split",
          "floating"
        ],
        "minWindowWidth": 320,
        "minWindowHeight": 240,
        "minWindowRatio": 0.5,
        "maxWindowRatio": 2,
        "description": "$string:QAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:QAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "isolationProcess": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home",
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.png",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.jpeg",
                "maxFileSupported": 10
              }
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "com.joinother.skyinstrument.stellarium-cat",
                "linkFeature": "FileOpen",
                "maxFileSupported": 10
              }
            ]
          }
        ],
        "metadata": [
          {
            "name": "enable.remove.starting.window",
            "value": "true"
          }
        ],
        "continuable": false
      }
    ],
    // 「桌面小组件（服务卡片）」入口暂时下线（2026-11）：不再声明 form 扩展，
    // 桌面/负一屏的卡片选择器里就不会出现星象仪。ETS 侧实现全部保留，恢复时把下面
    // 这段 extensionAbilities 放回来即可（同时确认 resources/base/profile/form_config.json 还在）。
    //   { "name": "SkyInstrumentFormAbility", "srcEntry": "./ets/form/SkyInstrumentFormAbility.ets",
    //     "label": "$string:QAbility_label", "description": "$string:QAbility_desc", "type": "form",
    //     "metadata": [ { "name": "ohos.extension.form", "resource": "$profile:form_config" } ] }
    "extensionAbilities": [],
    "requestPermissions": [
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:stellarium_permission_reason_location",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:stellarium_permission_reason_location",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACCELEROMETER",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GYROSCOPE",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.PUBLISH_AGENT_REMINDER",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
