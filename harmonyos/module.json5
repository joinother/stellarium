{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/qabilitystage/QAbilityStage.ets",
    "description": "$string:module_desc",
    "mainElement": "QAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "easyGo": "$profile:easy_go",
    "metadata": [
      {
        "name": "appgallery_privacy_hosted",
        "value": "1"
      },
      {
        "name": "appgallery_privacy_link_privacy_statement",
        "value": "https://agreement-drcn.hispace.dbankcloud.cn/index.html?lang=zh&agreementId=2004631976732052288"
      }
    ],
    "abilities": [
      {
        "name": "QAbility",
        "srcEntry": "./ets/qability/QAbility.ets",
        "launchType": "singleton",
        "description": "$string:QAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:QAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "isolationProcess": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home",
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.png",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.jpeg",
                "maxFileSupported": 10
              }
            ]
          }
        ],
        "metadata": [
          {
            "name": "enable.remove.starting.window",
            "value": "true"
          }
        ],
        "continuable": false
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:stellarium_permission_reason_location",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:stellarium_permission_reason_location",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.ACCELEROMETER",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      },
      {
        "name": "ohos.permission.GYROSCOPE",
        "usedScene": {
          "abilities": [
            "QAbility"
          ],
          "when": "inuse"
        }
      }
    ]
  }
}
